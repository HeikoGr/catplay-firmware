--- /dev/null
+++ b/drivers/pinctrl/sunxi/pinctrl-sun300i-v821-r.c
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Allwinner sun300i-v821 R-domain pin controller
+ *
+ * Minimal mainline-style port for early V821 bring-up.
+ * The controller exposes the PL bank.  Only the UART pin functions currently
+ * known from the vendor device trees are described.
+ */
+
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pinctrl/pinctrl.h>
+
+#include "pinctrl-sunxi.h"
+
+/*
+ * The sun300i-v821 R PIO uses the normal sunxi register layout:
+ *
+ *   0x00..0x0c  mux
+ *   0x10        data
+ *   0x14..0x18  drive strength
+ *   0x1c..0x20  pull
+ *
+ * The vendor DT assigns:
+ *   PL2/PL3 -> UART3
+ *   PL4/PL5 -> UART0
+ *
+ * Function 0xf is the vendor "io_disabled" state.  Mainline does not need a
+ * dedicated sleep state, but keeping the function in the table allows DTs
+ * recovered from vendor firmware to be represented without special handling.
+ */
+static const struct sunxi_desc_pin sun300i_v821_r_pins[] = {
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 0),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 0),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 1),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 1),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 2),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION(0x2, "uart3"),	/* TX/RX pair: PL2/PL3 */
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 2),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 3),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION(0x2, "uart3"),
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 3),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 4),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION(0x2, "uart0"),	/* TX/RX pair: PL4/PL5 */
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 4),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 5),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION(0x2, "uart0"),
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 5),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 6),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 6),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(L, 7),
+		  SUNXI_FUNCTION(0x0, "gpio_in"),
+		  SUNXI_FUNCTION(0x1, "gpio_out"),
+		  SUNXI_FUNCTION_IRQ_BANK(0xe, 0, 7),
+		  SUNXI_FUNCTION(0xf, "io_disabled")),
+};
+
+static const struct sunxi_pinctrl_desc sun300i_v821_r_pinctrl_data = {
+	.pins = sun300i_v821_r_pins,
+	.npins = ARRAY_SIZE(sun300i_v821_r_pins),
+	.pin_base = PL_BASE,
+	.irq_banks = 1,
+};
+
+static int sun300i_v821_r_pinctrl_probe(struct platform_device *pdev)
+{
+	return sunxi_pinctrl_init(pdev, &sun300i_v821_r_pinctrl_data);
+}
+
+static const struct of_device_id sun300i_v821_r_pinctrl_match[] = {
+	{ .compatible = "allwinner,sun300i-v821-r-pinctrl" },
+	{ }
+};
+
+static struct platform_driver sun300i_v821_r_pinctrl_driver = {
+	.probe = sun300i_v821_r_pinctrl_probe,
+	.driver = {
+		.name = "sun300i-v821-r-pinctrl",
+		.of_match_table = sun300i_v821_r_pinctrl_match,
+	},
+};
+builtin_platform_driver(sun300i_v821_r_pinctrl_driver);
