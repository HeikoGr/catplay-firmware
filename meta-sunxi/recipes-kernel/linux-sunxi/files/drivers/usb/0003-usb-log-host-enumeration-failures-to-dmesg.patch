Date: Fri, 14 Aug 2026 22:03:53 +0200
Subject: [PATCH] usb: log host enumeration failures to dmesg

Make the port connection, debounce and reset state visible without dynamic
debug or usbmon. Promote OHCI transfer condition codes to warnings so V821
host-role failures can be diagnosed from a captured kernel log.
Upstream-Status: Pending
---
 drivers/usb/core/hub.c     | 10 ++++++++--
 drivers/usb/core/message.c | 12 ++++++++++++
 drivers/usb/host/ohci-q.c  |  2 +-
 3 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/drivers/usb/core/hub.c b/drivers/usb/core/hub.c
index 5262e11c12cd..edc7d8e8f2c3 100644
--- a/drivers/usb/core/hub.c
+++ b/drivers/usb/core/hub.c
@@ -2976,6 +2976,10 @@ static int hub_port_wait_reset(struct usb_hub *hub, int port1,
 		if (ret < 0)
 			return ret;
 
+		dev_info(&hub->ports[port1 - 1]->dev,
+			 "reset wait %dms status %04x change %04x\n",
+			 delay_time + delay, portstatus, portchange);
+
 		/*
 		 * The port state is unknown until the reset completes.
 		 *
@@ -4728,7 +4732,7 @@ int hub_port_debounce(struct usb_hub *hub, int port1, bool must_be_connected)
 		msleep(HUB_DEBOUNCE_STEP);
 	}
 
-	dev_dbg(&port_dev->dev, "debounce total %dms stable %dms status 0x%x\n",
+	dev_info(&port_dev->dev, "debounce total %dms stable %dms status 0x%x\n",
 			total_time, stable_time, portstatus);
 
 	if (stable_time < HUB_DEBOUNCE_STABLE)
@@ -5028,6 +5032,8 @@ hub_port_init(struct usb_hub *hub, struct usb_device *udev, int port1,
 	 * value.
 	 */
 	do_new_scheme = use_new_scheme(udev, retry_counter, port_dev);
+	dev_info(&udev->dev, "enumeration attempt %d using %s scheme\n",
+		 retry_counter + 1, do_new_scheme ? "new" : "old");
 
 	for (retries = 0; retries < GET_DESCRIPTOR_TRIES; (++retries, msleep(100))) {
 		if (hub_port_stop_enumerate(hub, port1, retries)) {
@@ -5643,7 +5649,7 @@ static void hub_port_connect_change(struct usb_hub *hub, int port1,
 	struct usb_device_descriptor *descr;
 	int status = -ENODEV;
 
-	dev_dbg(&port_dev->dev, "status %04x, change %04x, %s\n", portstatus,
+	dev_info(&port_dev->dev, "status %04x, change %04x, %s\n", portstatus,
 			portchange, portspeed(hub, portstatus));
 
 	if (hub->has_indicators) {
diff --git a/drivers/usb/core/message.c b/drivers/usb/core/message.c
--- a/drivers/usb/core/message.c
+++ b/drivers/usb/core/message.c
@@ -79,6 +79,18 @@ static int usb_start_wait_urb(struct urb *urb, int timeout, int *actual_length,
 		else
 			retval = rc;
 
+		if (usb_pipecontrol(urb->pipe) && urb->setup_packet) {
+			const struct usb_ctrlrequest *dr =
+				(const void *)urb->setup_packet;
+
+			dev_warn(&urb->dev->dev,
+				 "control timeout: type=%02x request=%02x value=%04x index=%04x length=%u status=%d\n",
+				 dr->bRequestType, dr->bRequest,
+				 le16_to_cpu(dr->wValue),
+				 le16_to_cpu(dr->wIndex),
+				 le16_to_cpu(dr->wLength), retval);
+		}
+
 		dev_dbg(&urb->dev->dev,
 			"%s timed out or killed on ep%d%s len=%u/%u\n",
 			current->comm,
diff --git a/drivers/usb/host/ohci-q.c b/drivers/usb/host/ohci-q.c
index 3b445312beea..b9080a9de2ec 100644
--- a/drivers/usb/host/ohci-q.c
+++ b/drivers/usb/host/ohci-q.c
@@ -819,7 +819,7 @@ static int td_done(struct ohci_hcd *ohci, struct urb *urb, struct td *td)
 		}
 
 		if (cc != TD_CC_NOERROR && cc < 0x0E)
-			ohci_dbg(ohci,
+			ohci_warn(ohci,
 				"urb %p td %p (%d) cc %d, len=%d/%d\n",
 				urb, td, 1 + td->index, cc,
 				urb->actual_length,
-- 
2.55.0
