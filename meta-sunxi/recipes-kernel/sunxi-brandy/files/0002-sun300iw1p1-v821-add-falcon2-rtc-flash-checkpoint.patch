diff --git a/nboot/main/falcon2_main.c b/nboot/main/falcon2_main.c
new file mode 100644
index 0000000..2a580d9
--- /dev/null
+++ b/nboot/main/falcon2_main.c
@@ -0,0 +1,244 @@
+#include <common.h>
+#include <private_boot0.h>
+#include <private_uboot.h>
+#include <private_toc.h>
+#include <private_tee.h>
+#include <arch/clock.h>
+#include <arch/uart.h>
+#include <arch/dram.h>
+#include <arch/rtc.h>
+#include <arch/gpio.h>
+#include <arch/spinor.h>
+#include <arch/watchdog.h>
+#include <board_helper.h>
+#include <config.h>
+#include <boot_param.h>
+
+void main(void);
+
+#define CFG_FALCON_VERIFY_CRC 1
+#define CFG_FALCON_BUNDLE_FLASH_OFFSET 0x40000
+#define C2A_RISCV_BUNDLE_MAGIC	0x56523243
+#define C2A_RISCV_BUNDLE_GZIP	1
+
+struct c2a_riscv_bundle_entry {
+	uint size;
+	uint uncompressed_size;
+	uint compression_type;
+	phys_addr_t load_addr;
+	phys_addr_t jump_addr;
+	uint checksum; /* pre-decompression checksum*/
+};
+
+struct c2a_riscv_bundle {
+	uint magic;
+	uint header_checksum;
+	struct c2a_riscv_bundle_entry opensbi;
+	struct c2a_riscv_bundle_entry dtb;
+	struct c2a_riscv_bundle_entry kernel;
+};
+
+#define V821_FALCON2_RTC_BOOT_FAIL	0x46455253
+#define V821_FALCON2_RTC_WORD_INDEX	5
+#define V821_FALCON2_RTC_STATUS_INDEX	6
+#define V821_FALCON2_RTC_MARKER_INDEX	7
+
+#define FALCON2_ERR_FLASH_INIT		0x01
+#define FALCON2_ERR_HEADER_READ		0x02
+#define FALCON2_ERR_BAD_MAGIC		0x03
+#define FALCON2_ERR_HEADER_CRC		0x04
+#define FALCON2_ERR_UNSUPPORTED_COMP	0x05
+#define FALCON2_ERR_PAYLOAD_READ	0x06
+#define FALCON2_ERR_PAYLOAD_CRC		0x07
+#define FALCON2_ERR_GUNZIP		0x08
+#define FALCON2_ERR_MALLOC		0x09
+
+#define FALCON2_SECTOR_SIZE 512
+#define FALCON2_FLASH_SECTOR(offset) ((offset) / FALCON2_SECTOR_SIZE)
+#define FALCON2_SECTORS(size) (((size) + FALCON2_SECTOR_SIZE - 1) / FALCON2_SECTOR_SIZE)
+
+extern uint32_t crc32(uint32_t crc, const uint8_t *buf, uint len);
+
+static int boot0_clear_env(void)
+{
+	sunxi_board_exit();
+	sunxi_board_clock_reset();
+	mmu_disable();
+	mdelay(10);
+
+	return 0;
+}
+
+static void falcon2_rtc_report_error(int ret)
+{
+	rtc_set_fel_flag();
+	rtc_set_data(V821_FALCON2_RTC_WORD_INDEX, (unsigned long)ret);
+	rtc_set_data(V821_FALCON2_RTC_STATUS_INDEX, (unsigned long)(-ret));
+	rtc_set_data(V821_FALCON2_RTC_MARKER_INDEX, V821_FALCON2_RTC_BOOT_FAIL);
+}
+
+static void falcon2_boot_to_fel(int ret)
+{
+	falcon2_rtc_report_error(ret);
+	wdt_stop();
+	boot0_clear_env();
+	boot0_jmp(FEL_BASE);
+}
+
+static int falcon2_load_bundle_header(struct c2a_riscv_bundle *bundle)
+{
+	int ret;
+
+	ret = spinor_read(FALCON2_FLASH_SECTOR(CFG_FALCON_BUNDLE_FLASH_OFFSET),
+			  1, bundle);
+	if (ret) {
+		printf("falcon2: bundle header read failed\n");
+		return -FALCON2_ERR_HEADER_READ;
+	}
+
+	if (bundle->magic != C2A_RISCV_BUNDLE_MAGIC) {
+		printf("falcon2: bad bundle magic 0x%x\n", bundle->magic);
+		return -FALCON2_ERR_BAD_MAGIC;
+	}
+
+	if (crc32(0, (uint8_t *)&bundle->opensbi,
+		  sizeof(*bundle) - offsetof(struct c2a_riscv_bundle, opensbi)) !=
+	    bundle->header_checksum) {
+		printf("falcon2: bad bundle header checksum\n");
+		return -FALCON2_ERR_HEADER_CRC;
+	}
+
+	return 0;
+}
+
+static int falcon2_load_bundle_entry(const struct c2a_riscv_bundle_entry *entry,
+				     uint flash_offset)
+{
+	unsigned long len = entry->size;
+	void *src;
+	uint start_sector = FALCON2_FLASH_SECTOR(flash_offset);
+	uint sectors = FALCON2_SECTORS(entry->size);
+	uint read_size = sectors * FALCON2_SECTOR_SIZE;
+	int ret;
+
+	if (entry->compression_type != C2A_RISCV_BUNDLE_GZIP) {
+		printf("falcon2: unsupported compression %u\n",
+		       entry->compression_type);
+		return -FALCON2_ERR_UNSUPPORTED_COMP;
+	}
+
+	src = malloc(read_size);
+	if (!src) {
+		printf("falcon2: malloc failed for %u bytes\n", read_size);
+		return -FALCON2_ERR_MALLOC;
+	}
+
+	ret = spinor_read(start_sector, sectors, src);
+	if (ret) {
+		printf("falcon2: flash read failed at 0x%x\n", flash_offset);
+		ret = -FALCON2_ERR_PAYLOAD_READ;
+		goto out;
+	}
+
+	#if CFG_FALCON_VERIFY_CRC
+	if (crc32(0, src, entry->size) != entry->checksum) {
+		printf("falcon2: payload crc failed at 0x%x\n", flash_offset);
+		ret = -FALCON2_ERR_PAYLOAD_CRC;
+		goto out;
+	}
+	#endif
+
+	ret = gunzip((void *)entry->load_addr, entry->uncompressed_size, src, &len);
+	if (ret) {
+		printf("falcon2: gunzip failed at 0x%x: %d\n", flash_offset, ret);
+		ret = -FALCON2_ERR_GUNZIP;
+		goto out;
+	}
+
+	ret = 0;
+
+out:
+	free(src);
+	return ret;
+}
+
+static int falcon2_load_bundle(struct c2a_riscv_bundle *bundle)
+{
+	uint offset = CFG_FALCON_BUNDLE_FLASH_OFFSET + FALCON2_SECTOR_SIZE;
+	int ret;
+
+	ret = falcon2_load_bundle_entry(&bundle->opensbi, offset);
+	if (ret)
+		return ret;
+	offset += FALCON2_SECTORS(bundle->opensbi.size) * FALCON2_SECTOR_SIZE;
+
+	ret = falcon2_load_bundle_entry(&bundle->dtb, offset);
+	if (ret)
+		return ret;
+	offset += FALCON2_SECTORS(bundle->dtb.size) * FALCON2_SECTOR_SIZE;
+
+	return falcon2_load_bundle_entry(&bundle->kernel, offset);
+}
+
+static void falcon2_invalidate_bundle_entry(const struct c2a_riscv_bundle_entry *entry)
+{
+	flush_dcache_range(entry->load_addr,
+			   entry->load_addr + entry->uncompressed_size);
+}
+
+static void falcon2_invalidate_bundle(const struct c2a_riscv_bundle *bundle)
+{
+	falcon2_invalidate_bundle_entry(&bundle->opensbi);
+	falcon2_invalidate_bundle_entry(&bundle->dtb);
+	falcon2_invalidate_bundle_entry(&bundle->kernel);
+}
+
+void main(void)
+{
+	struct c2a_riscv_bundle bundle;
+	int ret;
+
+	sunxi_set_printf_debug_mode(0, 0);
+	wdt_start(15);
+	mmu_enable(BT0_head.dram_size);
+	malloc_init(CONFIG_HEAP_BASE, CONFIG_HEAP_SIZE);
+
+	if (rtc_probe_fel_flag()) {
+		rtc_clear_fel_flag();
+		wdt_stop();
+		boot0_clear_env();
+		boot0_jmp(FEL_BASE);
+		return;
+	}
+
+	ret = flash_init();
+	if (ret) {
+		printf("falcon2: flash init failed: %d\n", ret);
+		falcon2_boot_to_fel(-FALCON2_ERR_FLASH_INIT);
+		return;
+	}
+
+	dcache_enable();
+
+	ret = falcon2_load_bundle_header(&bundle);
+	if (ret) {
+		falcon2_boot_to_fel(ret);
+		return;
+	}
+
+	ret = falcon2_load_bundle(&bundle);
+	if (ret) {
+		falcon2_boot_to_fel(ret);
+		return;
+	}
+
+	falcon2_invalidate_bundle(&bundle);
+
+	wdt_stop();
+	mmu_disable();
+	boot0_jmp_opensbi_v1x(0, bundle.dtb.load_addr,
+			       bundle.opensbi.jump_addr, bundle.kernel.jump_addr);
+
+	while (1)
+		;
+}
