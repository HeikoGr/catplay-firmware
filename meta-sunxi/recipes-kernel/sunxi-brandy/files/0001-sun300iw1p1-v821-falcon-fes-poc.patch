diff --git a/nboot/main/falcon_main.c b/nboot/main/falcon_main.c
new file mode 100644
index 0000000..2975ed5
--- /dev/null
+++ b/nboot/main/falcon_main.c
@@ -0,0 +1,16 @@
+#include <common.h>
+#include <arch/watchdog.h>
+
+void main(void)
+{
+	/* FEL has already placed OpenSBI, DTB and Linux at fixed DRAM addresses. */
+	wdt_stop();
+	dcache_enable();
+	mmu_disable();
+	// sunxi_board_clock_reset();
+	boot0_jmp_opensbi_v1x(0, CFG_FALCON_DTB_ADDR,
+				 CFG_FALCON_OPENSBI_ADDR, CFG_FALCON_LINUX_ADDR);
+
+	while (1)
+		;
+}
