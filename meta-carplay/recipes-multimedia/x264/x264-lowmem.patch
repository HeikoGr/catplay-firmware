 #if HAVE_MALLOC_H
 #include <malloc.h>
@@ -34,9 +35,87 @@
 #if HAVE_THP
 #include <sys/mman.h>
 #endif
+#if defined(X264_MALLOC_TRACE) && (defined(__GLIBC__) || defined(__linux__))
+#include <execinfo.h>
+#include <unistd.h>
+#endif
 
 #define X264_ISDIGIT(x) isdigit((unsigned char)(x))
 
+#if defined(X264_MALLOC_TRACE) && (defined(__GLIBC__) || defined(__linux__))
+static int x264_malloc_trace_threshold( void )
+{
+    static int initialized = 0;
+    static int threshold = -1;
+    if( !initialized )
+    {
+        const char *env = getenv( "X264_TRACE_MALLOC_MIN" );
+        threshold = env && *env ? atoi( env ) : 131072;
+        initialized = 1;
+    }
+    return threshold;
+}
+
+static const char *x264_malloc_trace_exe( void )
+{
+    static int initialized = 0;
+    static char exe_path[PATH_MAX];
+    if( !initialized )
+    {
+        ssize_t len = readlink( "/proc/self/exe", exe_path, sizeof( exe_path ) - 1 );
+        if( len > 0 )
+            exe_path[len] = '\0';
+        else
+            exe_path[0] = '\0';
+        initialized = 1;
+    }
+    return exe_path;
+}
+
+static void x264_trace_large_malloc_addr2line( void *addr )
+{
+    const char *exe = x264_malloc_trace_exe();
+    if( !exe[0] )
+        return;
+
+    char cmd[PATH_MAX + 128];
+    snprintf( cmd, sizeof( cmd ), "addr2line -f -C -e '%s' %p", exe, addr );
+
+    FILE *fp = popen( cmd, "r" );
+    if( !fp )
+        return;
+
+    char line[512];
+    while( fgets( line, sizeof( line ), fp ) )
+        dprintf( STDERR_FILENO, "x264 [debug]:     %s", line );
+
+    pclose( fp );
+}
+
+static void x264_trace_large_malloc( int64_t i_size, void *ptr )
+{
+    int threshold = x264_malloc_trace_threshold();
+    if( threshold <= 0 || i_size < threshold )
+        return;
+
+    void *frames[32];
+    int frame_count = backtrace( frames, ARRAY_ELEMS( frames ) );
+    dprintf( STDERR_FILENO, "x264 [debug]: large malloc size=%"PRId64" ptr=%p threshold=%d\n",
+             i_size, ptr, threshold );
+    for( int i = 0; i < frame_count; i++ )
+    {
+        dprintf( STDERR_FILENO, "x264 [debug]:   frame[%d] %p\n", i, frames[i] );
+        x264_trace_large_malloc_addr2line( frames[i] );
+    }
+}
+#else
+static void x264_trace_large_malloc( int64_t i_size, void *ptr )
+{
+    (void)i_size;
+    (void)ptr;
+}
+#endif
+
 /****************************************************************************
  * x264_reduce_fraction:
  ****************************************************************************/
@@ -138,6 +217,8 @@ void *x264_malloc( int64_t i_size )
 #endif
     if( !align_buf )
         x264_log_internal( X264_LOG_ERROR, "malloc of size %"PRId64" failed\n", i_size );
+    else
+        x264_trace_large_malloc( i_size, align_buf );
     return align_buf;
 #undef HUGE_PAGE_SIZE
 #undef HUGE_PAGE_THRESHOLD
