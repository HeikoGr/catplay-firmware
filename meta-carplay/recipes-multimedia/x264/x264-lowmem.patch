+static uint8_t clamp_u8( int value )
+{
+    if( value < 0 )
+        return 0;
+    if( value > 255 )
+        return 255;
+    return value;
+}
+
+static void rgb_to_i420( const uint8_t *rgb, int width, int height, x264_picture_t *pic )
+{
+    uint8_t *plane_y = pic->img.plane[0];
+    uint8_t *plane_u = pic->img.plane[1];
+    uint8_t *plane_v = pic->img.plane[2];
+    const int stride_y = pic->img.i_stride[0];
+    const int stride_u = pic->img.i_stride[1];
+    const int stride_v = pic->img.i_stride[2];
+
+    for( int y = 0; y < height; y += 2 )
+    {
+        for( int x = 0; x < width; x += 2 )
+        {
+            int u_acc = 0;
+            int v_acc = 0;
+
+            for( int dy = 0; dy < 2; ++dy )
+            {
+                int src_y = y + dy;
+                uint8_t *dst_y = plane_y + src_y * stride_y;
+
+                for( int dx = 0; dx < 2; ++dx )
+                {
+                    int src_x = x + dx;
+                    const uint8_t *pixel = rgb + ( src_y * width + src_x ) * 3;
+                    int r = pixel[0];
+                    int g = pixel[1];
+                    int b = pixel[2];
+
+                    int y_value = ( ( 66 * r + 129 * g + 25 * b + 128 ) >> 8 ) + 16;
+                    int u_value = ( ( -38 * r - 74 * g + 112 * b + 128 ) >> 8 ) + 128;
+                    int v_value = ( ( 112 * r - 94 * g - 18 * b + 128 ) >> 8 ) + 128;
+
+                    dst_y[src_x] = clamp_u8( y_value );
+                    u_acc += u_value;
+                    v_acc += v_value;
+                }
+            }
+
+            plane_u[( y / 2 ) * stride_u + ( x / 2 )] = clamp_u8( ( u_acc + 2 ) / 4 );
+            plane_v[( y / 2 ) * stride_v + ( x / 2 )] = clamp_u8( ( v_acc + 2 ) / 4 );
+        }
+    }
+}
+
+static int load_png_rgb( const char *path, uint8_t **rgb, int *width, int *height )
+{
+    int ok = 0;
+    FILE *fp = NULL;
+    png_structp png = NULL;
+    png_infop info = NULL;
+    png_bytep *rows = NULL;
+    uint8_t *pixels = NULL;
+
+    fp = fopen( path, "rb" );
+    if( !fp )
+    {
+        fprintf( stderr, "unable to open png: %s\n", path );
+        goto cleanup;
+    }
+
+    png = png_create_read_struct( PNG_LIBPNG_VER_STRING, NULL, NULL, NULL );
+    if( !png )
+    {
+        fprintf( stderr, "unable to create png read struct\n" );
+        goto cleanup;
+    }
+
+    info = png_create_info_struct( png );
+    if( !info )
+    {
+        fprintf( stderr, "unable to create png info struct\n" );
+        goto cleanup;
+    }
+
+    if( setjmp( png_jmpbuf( png ) ) )
+    {
+        fprintf( stderr, "failed to decode png: %s\n", path );
+        goto cleanup;
+    }
+
+    png_init_io( png, fp );
+    png_read_info( png, info );
+
+    png_uint_32 png_width = 0;
+    png_uint_32 png_height = 0;
+    int bit_depth = 0;
+    int color_type = 0;
+    int interlace_type = 0;
+    int compression_type = 0;
+    int filter_method = 0;
+
+    png_get_IHDR( png, info, &png_width, &png_height, &bit_depth, &color_type,
+                  &interlace_type, &compression_type, &filter_method );
+
+    if( ( png_width & 1 ) || ( png_height & 1 ) )
+    {
+        fprintf( stderr, "png dimensions must be even for yuv420: %ux%u\n",
+                 png_width, png_height );
+        goto cleanup;
+    }
+
+    if( bit_depth == 16 )
+        png_set_strip_16( png );
+
+    if( color_type == PNG_COLOR_TYPE_PALETTE )
+        png_set_palette_to_rgb( png );
+
+    if( color_type == PNG_COLOR_TYPE_GRAY && bit_depth < 8 )
+        png_set_expand_gray_1_2_4_to_8( png );
+
+    if( png_get_valid( png, info, PNG_INFO_tRNS ) )
+        png_set_tRNS_to_alpha( png );
+
+    if( color_type == PNG_COLOR_TYPE_GRAY || color_type == PNG_COLOR_TYPE_GRAY_ALPHA )
+        png_set_gray_to_rgb( png );
+
+    if( color_type & PNG_COLOR_MASK_ALPHA )
+        png_set_strip_alpha( png );
+
+    png_read_update_info( png, info );
+
+    *width = (int)png_width;
+    *height = (int)png_height;
+
+    pixels = malloc( (size_t)( *width ) * (size_t)( *height ) * 3 );
+    if( !pixels )
+    {
+        fprintf( stderr, "out of memory for rgb buffer\n" );
+        goto cleanup;
+    }
+
+    rows = malloc( sizeof( png_bytep ) * (size_t)( *height ) );
+    if( !rows )
+    {
+        fprintf( stderr, "out of memory for png row pointers\n" );
+        goto cleanup;
+    }
+
+    for( int y = 0; y < *height; ++y )
+        rows[y] = pixels + (size_t)y * (size_t)( *width ) * 3;
+
+    png_read_image( png, rows );
+    png_read_end( png, NULL );
+
+    *rgb = pixels;
+    pixels = NULL;
+    ok = 1;
+
+cleanup:
+    free( rows );
+    free( pixels );
+    if( png || info )
+        png_destroy_read_struct( &png, &info, NULL );
+    if( fp )
+        fclose( fp );
+    return ok;
+}
+
