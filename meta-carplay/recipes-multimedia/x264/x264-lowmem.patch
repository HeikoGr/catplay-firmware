+        get_plane_ptr( h, src, (uint8_t **)&dst->src_plane[0], &dst->src_stride[0], 0, 0, 0 );
+        dst->src_stride[0] /= SIZEOF_PIXEL;
+        dst->plane[0] = dst->src_plane[0];
+        dst->filtered[0][0] = dst->plane[0];
+        dst->i_width[0] = h->param.i_width;
+        dst->i_lines[0] = h->param.i_height;
+        dst->i_stride[0] = dst->src_stride[0];
