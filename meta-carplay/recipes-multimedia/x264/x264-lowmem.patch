+static void x264_lowmem_copy_luma_mb( x264_t *h, int mb_x, int mb_y )
+{
+    pixel *dst = h->mb.pic.p_fenc[0];
+    pixel *src = h->fenc->src_plane[0];
+    int src_stride = h->fenc->src_stride[0];
+    int src_x = 16 * mb_x;
+    int src_y = 16 * mb_y;
+    int valid_w = X264_MIN( 16, h->param.i_width - src_x );
+    int valid_h = X264_MIN( 16, h->param.i_height - src_y );
+
+    for( int y = 0; y < valid_h; y++ )
+    {
+        pixel *src_row = src + (src_y + y) * src_stride + src_x;
+        pixel *dst_row = dst + y * FENC_STRIDE;
+        memcpy( dst_row, src_row, valid_w * SIZEOF_PIXEL );
+        for( int x = valid_w; x < 16; x++ )
+            dst_row[x] = dst_row[valid_w - 1];
+    }
+
+    for( int y = valid_h; y < 16; y++ )
+        memcpy( dst + y * FENC_STRIDE, dst + (valid_h - 1) * FENC_STRIDE, 16 * SIZEOF_PIXEL );
+}
+
+static void x264_lowmem_copy_chroma_mb( x264_t *h, int mb_x, int mb_y )
+{
+    pixel *dst_u = h->mb.pic.p_fenc[1];
+    pixel *dst_v = h->mb.pic.p_fenc[2];
+    int src_x = 8 * mb_x;
+    int src_y = (16 * mb_y) >> CHROMA_V_SHIFT;
+    int valid_w = X264_MIN( 8, (h->param.i_width >> CHROMA_H_SHIFT) - src_x );
+    int valid_h = X264_MIN( 8 >> (CHROMA_V_SHIFT - 1), (h->param.i_height >> CHROMA_V_SHIFT) - src_y );
+
+    if( h->fenc->src_csp == X264_CSP_NV12 || h->fenc->src_csp == X264_CSP_NV21 )
+    {
+        pixel *src_uv = h->fenc->src_plane[1];
+        int src_stride = h->fenc->src_stride[1];
+        int uv_swap = h->fenc->src_csp == X264_CSP_NV21;
+        for( int y = 0; y < valid_h; y++ )
+        {
+            pixel *src_row = src_uv + (src_y + y) * src_stride + src_x * 2;
+            pixel *dst_row_u = dst_u + y * FENC_STRIDE;
+            pixel *dst_row_v = dst_v + y * FENC_STRIDE;
+            for( int x = 0; x < valid_w; x++ )
+            {
+                dst_row_u[x] = src_row[2*x + uv_swap];
