+            get_plane_ptr( h, src, (uint8_t **)&dst->src_plane[1], &dst->src_stride[1], 1, 0, CHROMA_V_SHIFT );
+            dst->src_stride[1] /= SIZEOF_PIXEL;
+            dst->plane[1] = dst->src_plane[1];
+            dst->filtered[1][0] = dst->plane[1];
+        }
+        else if( i_csp == X264_CSP_I420 || i_csp == X264_CSP_YV12 )
+        {
+            int uv_swap = i_csp == X264_CSP_YV12;
+            get_plane_ptr( h, src, (uint8_t **)&dst->src_plane[1], &dst->src_stride[1], uv_swap ? 2 : 1, 1, CHROMA_V_SHIFT );
+            get_plane_ptr( h, src, (uint8_t **)&dst->src_plane[2], &dst->src_stride[2], uv_swap ? 1 : 2, 1, CHROMA_V_SHIFT );
+            dst->src_stride[1] /= SIZEOF_PIXEL;
