+gboolean btd_file_set_contents(const char *filename, const char *contents,
+					gssize length, GError **error)
+{
+	char *old_contents = NULL;
+	GError *read_error = NULL;
+	gsize old_length = 0;
+	char dirname[PATH_MAX], tmpname[PATH_MAX];
+	const char *base;
+	struct stat st;
+	mode_t mode = 0600;
+	int dir_fd = -1, fd = -1, err;
+	ssize_t written;
+	size_t pos = 0;
+
+	if (length < 0)
+		length = strlen(contents);
+
+	if (g_file_get_contents(filename, &old_contents, &old_length,
+							&read_error)) {
+		if (old_length == (gsize) length &&
+				!memcmp(old_contents, contents, length)) {
+			info("storage write path=%s payload_size=%lld dirty=false",
+						filename, (long long) length);
+			g_free(old_contents);
+			return TRUE;
+		}
+
+		g_free(old_contents);
+	} else if (!g_error_matches(read_error, G_FILE_ERROR,
+						G_FILE_ERROR_NOENT)) {
+		g_propagate_error(error, read_error);
+		return FALSE;
+	} else {
+		g_clear_error(&read_error);
+	}
+
+	info("storage write path=%s payload_size=%lld dirty=true",
+						filename, (long long) length);
+
+	create_dirs(filename, 0700);
+
+	base = strrchr(filename, '/');
+	if (!base) {
+		strcpy(dirname, ".");
+		base = filename;
+	} else {
+		size_t dir_len = base - filename;
+
+		if (dir_len >= sizeof(dirname)) {
+			g_set_error_literal(error, G_FILE_ERROR,
+					G_FILE_ERROR_NAMETOOLONG,
+					"Filename is too long");
+			return FALSE;
+		}
+
+		memcpy(dirname, filename, dir_len);
+		dirname[dir_len] = '\0';
+		base++;
+	}
+
+	if (snprintf(tmpname, sizeof(tmpname), "%s/.%s.XXXXXX",
+				dirname, base) >= (int) sizeof(tmpname)) {
+		g_set_error_literal(error, G_FILE_ERROR,
+				G_FILE_ERROR_NAMETOOLONG, "Filename is too long");
+		return FALSE;
+	}
+
+	fd = mkstemp(tmpname);
+	if (fd < 0)
+		goto fail;
+
+	if (!stat(filename, &st))
+		mode = st.st_mode & 0777;
+
+	if (fchmod(fd, mode) < 0)
+		goto fail;
+
+	while (pos < (size_t) length) {
+		written = write(fd, contents + pos, length - pos);
+		if (written < 0) {
+			if (errno == EINTR)
+				continue;
+			goto fail;
+		}
+		if (!written) {
+			errno = EIO;
+			goto fail;
+		}
+
+		pos += written;
+	}
+
+	if (fsync(fd) < 0)
+		goto fail;
+
+	if (close(fd) < 0) {
+		fd = -1;
+		goto fail;
+	}
+	fd = -1;
+
+	if (rename(tmpname, filename) < 0)
+		goto fail;
+
+	dir_fd = open(dirname, O_RDONLY | O_DIRECTORY);
+	if (dir_fd >= 0) {
+		if (fsync(dir_fd) < 0) {
+			err = errno;
+			close(dir_fd);
+			g_set_error(error, G_FILE_ERROR,
+					g_file_error_from_errno(err),
+					"Failed to sync %s: %s",
+					dirname, strerror(err));
+			return FALSE;
+		}
+		close(dir_fd);
+	}
+
+	return TRUE;
+
+fail:
+	err = errno;
+	if (fd >= 0)
+		close(fd);
+	unlink(tmpname);
+	g_set_error(error, G_FILE_ERROR, g_file_error_from_errno(err),
+				"Failed to write %s: %s", filename, strerror(err));
+	return FALSE;
+}
