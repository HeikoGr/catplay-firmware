Subject: [PATCH] mips: genex: use literal immediates for r4k wait skipover

LLVM's MIPS assembler does not accept assembler-computed label expressions
directly as immediate operands for the two-operand ori/addiu aliases:

  ori   k0, r4k_wait_idle_size - 2
  addiu k0, r4k_wait_exit - r4k_wait_insn + 2

Keep the assembler-time checks, but emit literal immediate operands for the
supported idle interrupt region sizes.  This preserves the skipover logic while
allowing clang/LLVM builds to assemble genex.S.

diff --git a/arch/mips/kernel/genex.S b/arch/mips/kernel/genex.S
index 08c0a01d9..72ee27d4a 100644
--- a/arch/mips/kernel/genex.S
+++ b/arch/mips/kernel/genex.S
@@ -146,10 +146,26 @@ r4k_wait_exit:
 	MFC0	k0, CP0_EPC
 	/* Subtract/add 2 to let the ISA bit propagate through the mask.  */
 	PTR_LA	k1, r4k_wait_insn - 2
-	ori 	k0, r4k_wait_idle_size - 2
+	.if	r4k_wait_idle_size == 4
+	ori	k0, 2
+	.elseif	r4k_wait_idle_size == 8
+	ori	k0, 6
+	.elseif	r4k_wait_idle_size == 16
+	ori	k0, 14
+	.elseif	r4k_wait_idle_size == 32
+	ori	k0, 30
+	.else
+	.error	"unsupported idle interrupt region size"
+	.endif
 	.set	noreorder
 	bne	k0, k1, \handler
-	PTR_ADDIU 	k0, r4k_wait_exit - r4k_wait_insn + 2
+	.if	r4k_wait_exit - r4k_wait_insn == 4
+	PTR_ADDIU	k0, 6
+	.elseif	r4k_wait_exit - r4k_wait_insn == 2
+	PTR_ADDIU	k0, 4
+	.else
+	.error	"unexpected wait instruction size"
+	.endif
 	.set	reorder
 	MTC0	k0, CP0_EPC
 	.set pop
