+
+static irqreturn_t ingenic_aes_irq(int irq, void *data)
+{
+	struct ingenic_aes_dev *aes = data;
+	u32 raw, mask, handled;
+
+	raw = ingenic_aes_read(aes, AES_ASSR);
+	mask = ingenic_aes_read(aes, AES_ASINTM);
+	handled = raw & mask;
+
+	if (!(handled & AES_STATUS_DMA_DONE))
+		return IRQ_NONE;
+
+	ingenic_aes_write(aes, AES_ASINTM, 0);
+	ingenic_aes_read(aes, AES_ASINTM);
+
+	ingenic_aes_write(aes, AES_ASSR,
+			  AES_STATUS_DMA_DONE | AES_STATUS_KEY_DONE);
+	ingenic_aes_read(aes, AES_ASSR);
+
+	aes->irq_status |= AES_STATUS_DMA_DONE;
+	dev_dbg(aes->dev,
+		"IRQ %d handled: raw_status=%08x mask=%08x handled=%08x\n",
+		irq, raw, mask, handled);
+	complete(&aes->done);
+
+	return IRQ_HANDLED;
+}
+
+static int ingenic_aes_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ingenic_aes_dev *aes;
+	unsigned int i;
+	int err;
+
+	if (ingenic_aes_dd)
+		return -EBUSY;
+
+	aes = devm_kzalloc(dev, sizeof(*aes), GFP_KERNEL);
+	if (!aes)
+		return -ENOMEM;
+
+	aes->dev = dev;
+	aes->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(aes->base))
+		return PTR_ERR(aes->base);
+
+	aes->mcu_ctrl = devm_ioremap(dev, INGENIC_PDMA_MCU_CTRL_PHYS,
+				     sizeof(u32));
+	if (!aes->mcu_ctrl)
+		return -ENOMEM;
+
+	aes->mcu_boot = devm_ioremap(dev, INGENIC_PDMA_MCU_BOOT_PHYS,
+				     sizeof(ingenic_pdma_wait_code));
+	if (!aes->mcu_boot)
+		return -ENOMEM;
+
+	aes->irq = platform_get_irq(pdev, 0);
+	if (aes->irq < 0)
+		return aes->irq;
+	dev_dbg(dev, "using IRQ %d\n", aes->irq);
+
+	aes->clk_aes = devm_clk_get(dev, "gate_aes");
+	if (IS_ERR(aes->clk_aes))
+		return dev_err_probe(dev, PTR_ERR(aes->clk_aes),
+				     "failed to get AES clock\n");
+
+	aes->clk_pdma = devm_clk_get(dev, "gate_pdma");
+	if (IS_ERR(aes->clk_pdma))
+		return dev_err_probe(dev, PTR_ERR(aes->clk_pdma),
+				     "failed to get PDMA clock\n");
+
+	for (i = 0; i < INGENIC_AES_DMA_SLOTS; i++) {
+		aes->buf_in[i] = devm_kmalloc(dev, INGENIC_AES_BUF_SIZE,
+					      GFP_KERNEL);
+		if (!aes->buf_in[i])
+			return -ENOMEM;
+		aes->dma_in[i] = dma_map_single(dev, aes->buf_in[i],
+						INGENIC_AES_BUF_SIZE,
+						DMA_TO_DEVICE);
+		if (dma_mapping_error(dev, aes->dma_in[i])) {
+			dev_err(dev, "failed to map AES input buffer %u\n", i);
+			goto err_unmap_buffers;
+		}
+		aes->dma_in_mapped[i] = true;
+
+		aes->buf_out[i] = devm_kmalloc(dev, INGENIC_AES_BUF_SIZE,
+					       GFP_KERNEL);
+		if (!aes->buf_out[i])
+			goto err_unmap_buffers;
+		aes->dma_out[i] = dma_map_single(dev, aes->buf_out[i],
+						 INGENIC_AES_BUF_SIZE,
+						 DMA_FROM_DEVICE);
+		if (dma_mapping_error(dev, aes->dma_out[i])) {
+			dev_err(dev, "failed to map AES output buffer %u\n", i);
+			goto err_unmap_buffers;
+		}
+		aes->dma_out_mapped[i] = true;
+	}
+
+	mutex_init(&aes->lock);
+	init_completion(&aes->done);
+	platform_set_drvdata(pdev, aes);
+
+	err = devm_request_irq(dev, aes->irq, ingenic_aes_irq, 0,
+			       dev_name(dev), aes);
+	if (err)
+		return dev_err_probe(dev, err, "failed to request IRQ %d\n",
+				     aes->irq);
+
+	err = clk_prepare_enable(aes->clk_aes);
+	if (err)
+		return dev_err_probe(dev, err, "failed to enable AES clock for probe\n");
+
+	err = clk_prepare_enable(aes->clk_pdma);
+	if (err) {
+		clk_disable_unprepare(aes->clk_aes);
+		return dev_err_probe(dev, err, "failed to enable PDMA clock for probe\n");
+	}
+
+	ingenic_aes_boot_pdma_mcu(aes);
+#if 1
+	clk_disable_unprepare(aes->clk_pdma);
+	clk_disable_unprepare(aes->clk_aes);
+#endif
+
+	ingenic_aes_dd = aes;
+
+	err = crypto_register_skciphers(ingenic_aes_algs,
+					ARRAY_SIZE(ingenic_aes_algs));
+	if (err) {
+		ingenic_aes_dd = NULL;
+		return err;
+	}
+
+	dev_info(dev, "Ingenic AES accelerator registered, irq=%d dma_in0=%pad dma_out0=%pad\n",
+		 aes->irq, &aes->dma_in[0], &aes->dma_out[0]);
+
+	return 0;
+err_unmap_buffers:
+	for (i = 0; i < INGENIC_AES_DMA_SLOTS; i++) {
+		if (aes->dma_out_mapped[i]) {
+			dma_unmap_single(dev, aes->dma_out[i],
+					 INGENIC_AES_BUF_SIZE,
+					 DMA_FROM_DEVICE);
+			aes->dma_out_mapped[i] = false;
+		}
+		if (aes->dma_in_mapped[i]) {
+			dma_unmap_single(dev, aes->dma_in[i],
+					 INGENIC_AES_BUF_SIZE,
+					 DMA_TO_DEVICE);
+			aes->dma_in_mapped[i] = false;
+		}
+	}
+	return -ENOMEM;
+}
+
+static void ingenic_aes_remove(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ingenic_aes_dev *aes = platform_get_drvdata(pdev);
+	unsigned int i;
+
+	for (i = 0; i < INGENIC_AES_DMA_SLOTS; i++) {
+		if (aes->dma_out_mapped[i]) {
+			dma_unmap_single(dev, aes->dma_out[i],
+					 INGENIC_AES_BUF_SIZE,
+					 DMA_FROM_DEVICE);
+			aes->dma_out_mapped[i] = false;
+		}
+		if (aes->dma_in_mapped[i]) {
+			dma_unmap_single(dev, aes->dma_in[i],
+					 INGENIC_AES_BUF_SIZE,
+					 DMA_TO_DEVICE);
+			aes->dma_in_mapped[i] = false;
+		}
+	}
+
+	crypto_unregister_skciphers(ingenic_aes_algs,
+				    ARRAY_SIZE(ingenic_aes_algs));
+	ingenic_aes_dd = NULL;
+}
+
+static const struct of_device_id ingenic_aes_of_match[] = {
+	{ .compatible = "ingenic,aes" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, ingenic_aes_of_match);
+
+static struct platform_driver ingenic_aes_driver = {
+	.probe = ingenic_aes_probe,
+	.remove = ingenic_aes_remove,
+	.driver = {
+		.name = "ingenic-aes",
+		.of_match_table = ingenic_aes_of_match,
+	},
+};
+module_platform_driver(ingenic_aes_driver);
+
+MODULE_DESCRIPTION("Ingenic AES hardware accelerator");
+MODULE_AUTHOR("Stephon.Qiu");
+MODULE_AUTHOR("CatPlay");
+MODULE_LICENSE("GPL");
