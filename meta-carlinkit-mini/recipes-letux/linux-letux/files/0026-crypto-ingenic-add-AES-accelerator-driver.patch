Subject: [PATCH] crypto: ingenic: add AES accelerator driver

diff --git a/crypto/Kconfig b/crypto/Kconfig
index a997e9793..d179c9437 100644
--- a/crypto/Kconfig
+++ b/crypto/Kconfig
@@ -342,6 +342,20 @@ config CRYPTO_AES
 
 	  The AES specifies three key sizes: 128, 192 and 256 bits
 
+config CRYPTO_DEV_INGENIC_AES
+	tristate "Ingenic AES hardware accelerator"
+	depends on OF && HAS_IOMEM
+	depends on HAS_DMA
+	depends on MIPS || COMPILE_TEST
+	select CRYPTO_AES
+	select CRYPTO_SKCIPHER
+	select CRYPTO_ECB
+	select CRYPTO_CBC
+	help
+	  Enable support for the AES hardware accelerator found in Ingenic
+	  SoCs. The driver registers ECB-AES, CBC-AES and CTR-AES skcipher
+	  algorithms.
+
 config CRYPTO_AES_TI
 	tristate "AES (Advanced Encryption Standard) (fixed time)"
 	select CRYPTO_ALGAPI
diff --git a/crypto/Makefile b/crypto/Makefile
index 4c99e5d37..bbfc29ced 100644
--- a/crypto/Makefile
+++ b/crypto/Makefile
@@ -133,6 +133,7 @@ obj-$(CONFIG_CRYPTO_SERPENT) += serpent_generic.o
 CFLAGS_serpent_generic.o := $(call cc-option,-fsched-pressure)  # https://gcc.gnu.org/bugzilla/show_bug.cgi?id=79149
 obj-$(CONFIG_CRYPTO_AES) += aes_generic.o
 CFLAGS_aes_generic.o := $(call cc-option,-fno-code-hoisting) # https://gcc.gnu.org/bugzilla/show_bug.cgi?id=83356
+obj-$(CONFIG_CRYPTO_DEV_INGENIC_AES) += ingenic-aes.o
 obj-$(CONFIG_CRYPTO_SM4) += sm4.o
 obj-$(CONFIG_CRYPTO_SM4_GENERIC) += sm4_generic.o
 obj-$(CONFIG_CRYPTO_AES_TI) += aes_ti.o
diff --git a/crypto/ingenic-aes.c b/crypto/ingenic-aes.c
new file mode 100644
index 000000000..18a2dfabd
--- /dev/null
+++ b/crypto/ingenic-aes.c
@@ -0,0 +1,1335 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Ingenic AES hardware accelerator.
+ *
+ * Ported from the Ingenic 4.4 ablkcipher driver to the Linux 6.12 skcipher
+ * API. The hardware interface is intentionally kept close to the vendor
+ * driver, with ASCR.ENDIAN used for byte-stream crypto API buffers.
+ */
+
+#include <crypto/aes.h>
+#include <crypto/algapi.h>
+#include <crypto/internal/skcipher.h>
+#include <linux/clk.h>
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/err.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
+#include <linux/minmax.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+#define INGENIC_AES_BUF_SIZE		(16 * 1024)
+#define INGENIC_AES_DMA_SLOTS		2
+#define INGENIC_AES_TIMEOUT_MS		1000
+#define INGENIC_AES_CTR_PROFILE_CHUNKS	1024
+#define INGENIC_AES_XOR_PREFETCH_BYTES	128
+#define INGENIC_PDMA_MCU_CTRL_PHYS	0x13421030
+#define INGENIC_PDMA_MCU_BOOT_PHYS	0x13422000
+
+#define DMCS_SLEEP			BIT(31)
+#define DMCS_SW_RST			BIT(0)
+
+#define AES_ASCR			0x00
+#define AES_ASSR			0x04
+#define AES_ASINTM			0x08
+#define AES_ASSA			0x0c
+#define AES_ASDA			0x10
+#define AES_ASTC			0x14
+#define AES_ASKY			0x20
+#define AES_ASIV			0x24
+
+#define ASCR_PS_DEF			(3 << 28)
+#define ASCR_ENDIAN			BIT(11)
+#define ASCR_CLR			BIT(10)
+#define ASCR_DMAS			BIT(9)
+#define ASCR_DMAE			BIT(8)
+#define ASCR_KEYL(len)			((len) << 6)
+#define ASCR_ALGS(alg)			((alg) << 5)
+#define ASCR_DECE(mode)			((mode) << 4)
+#define ASCR_KEYS			BIT(2)
+#define ASCR_INIT_IV			BIT(1)
+#define ASCR_EN				BIT(0)
+
+#define AES_STATUS_KEY_DONE		BIT(0)
+#define AES_STATUS_DMA_DONE		BIT(2)
+
+#define INGENIC_AES_MODE_ECB		0
+#define INGENIC_AES_MODE_CBC		BIT(0)
+#define INGENIC_AES_DECRYPT		BIT(1)
+
+#define INGENIC_AES_ALG_ECB		0
+#define INGENIC_AES_ALG_CBC		1
+#define INGENIC_AES_ENCRYPT		0
+#define INGENIC_AES_DECRYPT_HW		1
+
+struct ingenic_aes_dev {
+	struct device *dev;
+	void __iomem *base;
+	void __iomem *mcu_ctrl;
+	void __iomem *mcu_boot;
+	struct clk *clk_aes;
+	struct clk *clk_pdma;
+	int irq;
+	struct mutex lock;
+	struct completion done;
+	u32 irq_status;
+	u8 *buf_in[INGENIC_AES_DMA_SLOTS];
+	u8 *buf_out[INGENIC_AES_DMA_SLOTS];
+	dma_addr_t dma_in[INGENIC_AES_DMA_SLOTS];
+	dma_addr_t dma_out[INGENIC_AES_DMA_SLOTS];
+	bool dma_in_mapped[INGENIC_AES_DMA_SLOTS];
+	bool dma_out_mapped[INGENIC_AES_DMA_SLOTS];
+	u64 ctr_profile_fill_ns;
+	u64 ctr_profile_dma_ns;
+	u64 ctr_profile_xor_ns;
+	u64 ctr_profile_bytes;
+	u32 ctr_profile_chunks;
+};
+
+struct ingenic_aes_ctx {
+	struct ingenic_aes_dev *aes;
+	u32 key[AES_MAX_KEY_SIZE / sizeof(u32)];
+	unsigned int keylen;
+};
+
+static struct ingenic_aes_dev *ingenic_aes_dd;
+static int profile = 1;
+module_param(profile, int, 0644);
+MODULE_PARM_DESC(profile, "Enable CTR profiling prints");
+
+/*
+ * Vendor 4.4 driver boots the PDMA MCU before using AES. Keep the payload as
+ * raw MIPS32 opcodes so this driver still builds under COMPILE_TEST.
+ */
+static const u32 ingenic_pdma_wait_code[] = {
+	0x341a0000,	/* li k0, 0 */
+	0x409a6000,	/* mtc0 k0, c0_status */
+	0x00000000,	/* nop */
+	0x42000020,	/* wait */
+	0x1000fffe,	/* b .-4 */
+	0x00000000,	/* nop */
+};
+
+static inline u32 ingenic_aes_read(struct ingenic_aes_dev *aes, u32 reg)
+{
+	return readl(aes->base + reg);
+}
+
+static inline void ingenic_aes_write(struct ingenic_aes_dev *aes, u32 reg, u32 val)
+{
+	writel(val, aes->base + reg);
+}
+
+static inline void ingenic_aes_sync_input_for_cpu(struct ingenic_aes_dev *aes,
+						  unsigned int slot,
+						  unsigned int len)
+{
+	if (!len)
+		return;
+
+	dma_sync_single_for_cpu(aes->dev, aes->dma_in[slot], len,
+				DMA_TO_DEVICE);
+}
+
+static inline void ingenic_aes_sync_input_for_device(struct ingenic_aes_dev *aes,
+						     unsigned int slot,
+						     unsigned int len)
+{
+	if (!len)
+		return;
+
+	dma_sync_single_for_device(aes->dev, aes->dma_in[slot], len,
+				   DMA_TO_DEVICE);
+}
+
+static inline void ingenic_aes_sync_output_for_device(struct ingenic_aes_dev *aes,
+						      unsigned int slot,
+						      unsigned int len)
+{
+	if (!len)
+		return;
+
+	dma_sync_single_for_device(aes->dev, aes->dma_out[slot], len,
+				   DMA_FROM_DEVICE);
+}
+
+static inline void ingenic_aes_sync_output_for_cpu(struct ingenic_aes_dev *aes,
+						    unsigned int slot,
+						    unsigned int len)
+{
+	if (!len)
+		return;
+
+	dma_sync_single_for_cpu(aes->dev, aes->dma_out[slot], len,
+				DMA_FROM_DEVICE);
+}
+
+static void ingenic_aes_boot_pdma_mcu(struct ingenic_aes_dev *aes)
+{
+	unsigned int i;
+	u32 dmcs;
+	int err;
+
+	writel(DMCS_SW_RST, aes->mcu_ctrl);
+	for (i = 0; i < ARRAY_SIZE(ingenic_pdma_wait_code); i++)
+		writel(ingenic_pdma_wait_code[i], aes->mcu_boot + i * sizeof(u32));
+	writel(0, aes->mcu_ctrl);
+
+	err = readl_poll_timeout(aes->mcu_ctrl, dmcs, dmcs & DMCS_SLEEP,
+				 10, 10000);
+	if (err)
+		dev_warn(aes->dev, "PDMA MCU boot sleep poll timed out, DMCS=%08x\n",
+			 dmcs);
+
+	dev_info(aes->dev, "PDMA MCU booted, DMCS=%08x\n",
+		 readl(aes->mcu_ctrl));
+}
+
+static void ingenic_aes_dump_regs(struct ingenic_aes_dev *aes,
+				  const char *where)
+{
+	dev_err(aes->dev,
+		"%s: ASCR=%08x ASSR=%08x ASINTM=%08x ASSA=%08x ASDA=%08x ASTC=%08x irq_status=%08x dma_in0=%pad dma_out0=%pad\n",
+		where,
+		ingenic_aes_read(aes, AES_ASCR),
+		ingenic_aes_read(aes, AES_ASSR),
+		ingenic_aes_read(aes, AES_ASINTM),
+		ingenic_aes_read(aes, AES_ASSA),
+		ingenic_aes_read(aes, AES_ASDA),
+		ingenic_aes_read(aes, AES_ASTC),
+		aes->irq_status, &aes->dma_in[0], &aes->dma_out[0]);
+}
+
+static int ingenic_aes_wait_key(struct ingenic_aes_dev *aes)
+{
+	unsigned int timeout = 1000;
+
+	while (!(ingenic_aes_read(aes, AES_ASSR) & AES_STATUS_KEY_DONE)) {
+		if (!--timeout) {
+			ingenic_aes_dump_regs(aes, "key setup timeout");
+			return -ETIMEDOUT;
+		}
+		cpu_relax();
+	}
+
+	/*
+	 * KEY_DONE is sticky and W1C. Clear it after a successful poll so the
+	 * next request cannot observe stale key-setup completion.
+	 */
+	ingenic_aes_write(aes, AES_ASSR, AES_STATUS_KEY_DONE);
+	ingenic_aes_read(aes, AES_ASSR);
+
+	return 0;
+}
+
+static int ingenic_aes_prepare(struct ingenic_aes_dev *aes,
+			       struct ingenic_aes_ctx *ctx, u8 *iv,
+			       unsigned long mode)
+{
+	unsigned int key_words = ctx->keylen / sizeof(u32);
+	u32 keylen, alg, dir, ctrl;
+	unsigned int i;
+
+	switch (ctx->keylen) {
+	case AES_KEYSIZE_128:
+		keylen = 0;
+		break;
+	case AES_KEYSIZE_192:
+		keylen = 1;
+		break;
+	case AES_KEYSIZE_256:
+		keylen = 2;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	alg = mode & INGENIC_AES_MODE_CBC ? INGENIC_AES_ALG_CBC :
+					    INGENIC_AES_ALG_ECB;
+	dir = mode & INGENIC_AES_DECRYPT ? INGENIC_AES_DECRYPT_HW :
+					   INGENIC_AES_ENCRYPT;
+
+	ingenic_aes_write(aes, AES_ASINTM, 0);
+	ingenic_aes_read(aes, AES_ASSR);
+	ingenic_aes_write(aes, AES_ASCR, ASCR_PS_DEF | ASCR_CLR | ASCR_EN);
+
+	ctrl = ASCR_PS_DEF | ASCR_ENDIAN | ASCR_KEYL(keylen) | ASCR_ALGS(alg) |
+	       ASCR_DECE(dir) | ASCR_EN;
+	ingenic_aes_write(aes, AES_ASCR, ctrl);
+
+	if (alg == INGENIC_AES_ALG_CBC) {
+		u32 *iv32 = (u32 *)iv;
+
+		for (i = 0; i < AES_BLOCK_SIZE / sizeof(u32); i++)
+			ingenic_aes_write(aes, AES_ASIV, iv32[i]);
+
+		ingenic_aes_write(aes, AES_ASCR,
+				  ingenic_aes_read(aes, AES_ASCR) |
+				  ASCR_INIT_IV);
+	}
+
+	for (i = 0; i < key_words; i++)
+		ingenic_aes_write(aes, AES_ASKY, ctx->key[i]);
+
+	ingenic_aes_write(aes, AES_ASCR, ingenic_aes_read(aes, AES_ASCR) |
+			  ASCR_KEYS);
+
+	return ingenic_aes_wait_key(aes);
+}
+
+static int ingenic_aes_dma_start_addr(struct ingenic_aes_dev *aes,
+				      unsigned int slot, dma_addr_t dma_in,
+				      dma_addr_t dma_out, unsigned int len)
+{
+	u32 ctrl, status;
+	unsigned int blocks;
+
+	if (WARN_ON_ONCE(!len))
+		return -EINVAL;
+
+	if (WARN_ON_ONCE(len & (AES_BLOCK_SIZE - 1)))
+		return -EINVAL;
+
+	if (WARN_ON_ONCE(len > INGENIC_AES_BUF_SIZE))
+		return -EINVAL;
+
+	blocks = len / AES_BLOCK_SIZE;
+
+	if (WARN_ON_ONCE(!blocks))
+		return -EINVAL;
+
+	/*
+	 * The engine has a single DMA/status/IRQ state machine. Always start from
+	 * a quiet state so a stale DMA_DONE cannot complete the next transfer.
+	 */
+
+	/* 1. Mask AES interrupts first. */
+	ingenic_aes_write(aes, AES_ASINTM, 0);
+	ingenic_aes_read(aes, AES_ASINTM);
+
+	/*
+	 * 2. Disarm DMA start/enable bits before touching addresses/count. If
+	 * DMAS is self-clearing this is harmless; if not, this is required.
+	 */
+	ctrl = ingenic_aes_read(aes, AES_ASCR);
+	ctrl &= ~(ASCR_DMAS | ASCR_DMAE);
+	ingenic_aes_write(aes, AES_ASCR, ctrl);
+	ingenic_aes_read(aes, AES_ASCR);
+
+	/*
+	 * 3. Clear sticky completion bits from the previous operation. KEY_DONE
+	 * may remain sticky after setkey, but clearing it here avoids aggregated
+	 * or level IRQ weirdness on this block.
+	 */
+	ingenic_aes_write(aes, AES_ASSR,
+			  AES_STATUS_DMA_DONE | AES_STATUS_KEY_DONE);
+	ingenic_aes_read(aes, AES_ASSR);
+
+	status = ingenic_aes_read(aes, AES_ASSR);
+	/*if (WARN_ON_ONCE(status & AES_STATUS_DMA_DONE))
+		return -EIO;*/
+
+	/*
+	 * 4. Program DMA source, destination and transfer count while DMA is
+	 * disabled and IRQ is masked.
+	 */
+	ingenic_aes_write(aes, AES_ASSA, dma_in);
+	ingenic_aes_write(aes, AES_ASDA, dma_out);
+	/* ASTC counts AES blocks, not 64-bit words: 1 block == 128 bits. */
+	ingenic_aes_write(aes, AES_ASTC, blocks);
+
+	/*
+	 * Make sure coherent buffer stores and MMIO programming are visible before
+	 * the hardware is allowed to fetch source data.
+	 *
+	 * For dma_alloc_coherent this is mostly about ordering, not cache flush.
+	 */
+	dma_wmb();
+	ingenic_aes_sync_input_for_device(aes, slot, len);
+	ingenic_aes_sync_output_for_device(aes, slot, len);
+
+	/*
+	 * 5. Reset software completion state after all stale HW state has been
+	 * cleared, but before IRQ is unmasked.
+	 */
+	reinit_completion(&aes->done);
+	aes->irq_status = 0;
+
+	/*
+	 * 6. Clear once more immediately before enabling IRQ, in case writing
+	 * ASSA/ASDA/ASTC perturbed status on this IP.
+	 */
+	ingenic_aes_write(aes, AES_ASSR,
+			  AES_STATUS_DMA_DONE | AES_STATUS_KEY_DONE);
+	ingenic_aes_read(aes, AES_ASSR);
+
+	/* 7. Unmask only DMA_DONE. */
+	ingenic_aes_write(aes, AES_ASINTM, AES_STATUS_DMA_DONE);
+	ingenic_aes_read(aes, AES_ASINTM);
+
+	/*
+	 * 8. Start DMA as the final operation. Keep existing mode/key/algorithm
+	 * bits in ASCR, only add DMAE/DMAS/EN.
+	 */
+	ctrl = ingenic_aes_read(aes, AES_ASCR);
+	dev_dbg(aes->dev,
+		"starting DMA slot=%u len=%u ctrl=%08x status=%08x intm=%08x\n",
+		slot, len, ctrl, ingenic_aes_read(aes, AES_ASSR),
+		ingenic_aes_read(aes, AES_ASINTM));
+	ctrl |= ASCR_EN | ASCR_DMAE | ASCR_DMAS;
+	ingenic_aes_write(aes, AES_ASCR, ctrl);
+	ingenic_aes_read(aes, AES_ASCR);
+
+	return 0;
+}
+
+static int ingenic_aes_dma_start(struct ingenic_aes_dev *aes,
+				 unsigned int slot, unsigned int len)
+{
+	return ingenic_aes_dma_start_addr(aes, slot, aes->dma_in[slot],
+					  aes->dma_out[slot], len);
+}
+
+static int ingenic_aes_dma_wait(struct ingenic_aes_dev *aes)
+{
+	unsigned long timeout;
+
+	dev_dbg(aes->dev, "DMA wait started\n");
+
+	timeout = wait_for_completion_timeout(&aes->done,
+			msecs_to_jiffies(INGENIC_AES_TIMEOUT_MS));
+	if (!timeout) {
+		ingenic_aes_write(aes, AES_ASINTM, 0);
+		ingenic_aes_dump_regs(aes, "DMA timeout");
+		return -ETIMEDOUT;
+	}
+
+	dma_rmb();
+
+	dev_dbg(aes->dev, "DMA wait finished\n");
+
+	ingenic_aes_write(aes, AES_ASINTM, 0);
+
+	if (!(aes->irq_status & AES_STATUS_DMA_DONE)) {
+		ingenic_aes_dump_regs(aes, "DMA completed without DMA_DONE");
+		return -EIO;
+	}
+
+	return 0;
+}
+
+static int ingenic_aes_dma_crypt(struct ingenic_aes_dev *aes, unsigned int len)
+{
+	int err = ingenic_aes_dma_start(aes, 0, len);
+
+	if (err)
+		return err;
+
+	return ingenic_aes_dma_wait(aes);
+}
+
+static void ingenic_aes_stop(struct ingenic_aes_dev *aes)
+{
+	u32 ctrl = ingenic_aes_read(aes, AES_ASCR);
+
+	ingenic_aes_write(aes, AES_ASCR, ctrl & ~ASCR_EN);
+}
+
+static int ingenic_aes_crypt(struct skcipher_request *req, unsigned long mode)
+{
+	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(req);
+	struct ingenic_aes_ctx *ctx = crypto_skcipher_ctx(tfm);
+	struct ingenic_aes_dev *aes = ctx->aes;
+	unsigned int done = 0;
+	u8 next_iv[AES_BLOCK_SIZE];
+	int src_nents, dst_nents;
+	int err = 0;
+
+	if (!aes)
+		return -ENODEV;
+
+	if (!IS_ALIGNED(req->cryptlen, AES_BLOCK_SIZE))
+		return -EINVAL;
+
+	if (!req->cryptlen)
+		return 0;
+
+	src_nents = sg_nents_for_len(req->src, req->cryptlen);
+	if (src_nents < 0)
+		return src_nents;
+
+	dst_nents = sg_nents_for_len(req->dst, req->cryptlen);
+	if (dst_nents < 0)
+		return dst_nents;
+
+	mutex_lock(&aes->lock);
+
+#if 1
+	err = clk_prepare_enable(aes->clk_aes);
+	if (err) {
+		dev_err(aes->dev, "failed to enable AES clock: %d\n", err);
+		goto out_unlock;
+	}
+
+	err = clk_prepare_enable(aes->clk_pdma);
+	if (err) {
+		dev_err(aes->dev, "failed to enable PDMA clock: %d\n", err);
+		goto out_disable_aes;
+	}
+#endif
+
+	err = ingenic_aes_prepare(aes, ctx, req->iv, mode);
+	if (err) {
+		dev_err(aes->dev, "failed to prepare AES mode=%lx keylen=%u: %d\n",
+			mode, ctx->keylen, err);
+		goto out_stop;
+	}
+
+	while (done < req->cryptlen) {
+		unsigned int chunk = min_t(unsigned int,
+					   req->cryptlen - done,
+					   INGENIC_AES_BUF_SIZE);
+
+		chunk &= ~(AES_BLOCK_SIZE - 1);
+		if (!chunk) {
+			err = -EINVAL;
+			break;
+		}
+
+		if (mode & INGENIC_AES_MODE_CBC) {
+			if (mode & INGENIC_AES_DECRYPT)
+				sg_pcopy_to_buffer(req->src, src_nents, next_iv,
+						   AES_BLOCK_SIZE,
+						   done + chunk - AES_BLOCK_SIZE);
+		}
+
+		ingenic_aes_sync_input_for_cpu(aes, 0, chunk);
+		if (sg_pcopy_to_buffer(req->src, src_nents, aes->buf_in[0],
+				       chunk, done) != chunk) {
+			err = -EINVAL;
+			break;
+		}
+
+		err = ingenic_aes_dma_crypt(aes, chunk);
+		if (err) {
+			dev_err(aes->dev,
+				"DMA crypt failed mode=%lx cryptlen=%u offset=%u chunk=%u: %d\n",
+				mode, req->cryptlen, done, chunk, err);
+			break;
+		}
+		ingenic_aes_sync_output_for_cpu(aes, 0, chunk);
+		if (sg_pcopy_from_buffer(req->dst, dst_nents, aes->buf_out[0],
+					 chunk, done) != chunk) {
+			err = -EINVAL;
+			break;
+		}
+
+		if (mode & INGENIC_AES_MODE_CBC) {
+			if (!(mode & INGENIC_AES_DECRYPT))
+				memcpy(next_iv, aes->buf_out[0] + chunk -
+				       AES_BLOCK_SIZE, AES_BLOCK_SIZE);
+			memcpy(req->iv, next_iv, AES_BLOCK_SIZE);
+		}
+
+		done += chunk;
+	}
+
+out_stop:
+	ingenic_aes_stop(aes);
+#if 1
+	clk_disable_unprepare(aes->clk_pdma);
+out_disable_aes:
+	clk_disable_unprepare(aes->clk_aes);
+#endif
+out_unlock:
+	mutex_unlock(&aes->lock);
+
+	return err;
+}
+
+static void ingenic_aes_ctr_fill_counter_blocks(u8 *dst, u8 *iv,
+						unsigned int len)
+{
+	unsigned int blocks = len / AES_BLOCK_SIZE;
+	u32 *dst32 = (u32 *)dst;
+	u32 w0, w1, w2;
+	u32 ctr;
+
+	/*
+	 * Copy the first 96 bits of IV as raw bytes. Native-endian load plus
+	 * native-endian store preserves byte layout on the same CPU, and these
+	 * loads are outside the hot loop.
+	 */
+	w0 = get_unaligned((const u32 *)(iv + 0));
+	w1 = get_unaligned((const u32 *)(iv + 4));
+	w2 = get_unaligned((const u32 *)(iv + 8));
+	ctr = get_unaligned_be32(iv + 12);
+
+	/*
+	 * Extremely unlikely. If the low 32-bit counter would wrap, fall back
+	 * to the generic crypto_inc() path so the whole 128-bit IV increments
+	 * correctly.
+	 */
+	if (unlikely(blocks > U32_MAX - ctr)) {
+		unsigned int i;
+
+		for (i = 0; i < len; i += AES_BLOCK_SIZE) {
+			memcpy(dst + i, iv, AES_BLOCK_SIZE);
+			crypto_inc(iv, AES_BLOCK_SIZE);
+		}
+
+		return;
+	}
+
+	/*
+	 * Keep four independent counters in memory/store representation and
+	 * increment each by cpu_to_be32(4). This is valid only until the low
+	 * byte carries, so each inner loop stops at the next 256-counter
+	 * boundary.
+	 */
+	while (blocks) {
+		unsigned int n = min_t(unsigned int, blocks,
+				       256U - (ctr & 0xff));
+		const u32 be_inc4 = cpu_to_be32(4);
+
+		while (n >= 4) {
+			u32 c0 = cpu_to_be32(ctr + 0);
+			u32 c1 = cpu_to_be32(ctr + 1);
+			u32 c2 = cpu_to_be32(ctr + 2);
+			u32 c3 = cpu_to_be32(ctr + 3);
+
+			do {
+				dst32[0] = w0;
+				dst32[1] = w1;
+				dst32[2] = w2;
+				dst32[3] = c0;
+
+				dst32[4] = w0;
+				dst32[5] = w1;
+				dst32[6] = w2;
+				dst32[7] = c1;
+
+				dst32[8] = w0;
+				dst32[9] = w1;
+				dst32[10] = w2;
+				dst32[11] = c2;
+
+				dst32[12] = w0;
+				dst32[13] = w1;
+				dst32[14] = w2;
+				dst32[15] = c3;
+
+				c0 += be_inc4;
+				c1 += be_inc4;
+				c2 += be_inc4;
+				c3 += be_inc4;
+				dst32 += 16;
+				ctr += 4;
+				blocks -= 4;
+				n -= 4;
+			} while (n >= 4);
+		}
+
+		{
+			u32 be_ctr = cpu_to_be32(ctr);
+			const u32 be_inc = cpu_to_be32(1);
+
+			while (n--) {
+				dst32[0] = w0;
+				dst32[1] = w1;
+				dst32[2] = w2;
+				dst32[3] = be_ctr;
+				be_ctr += be_inc;
+
+				dst32 += 4;
+				ctr++;
+				blocks--;
+			}
+		}
+	}
+
+	put_unaligned_be32(ctr, iv + 12);
+}
+
+static void ingenic_aes_xor_copy_c(u8 *dst, const u8 *src, const u8 *ks,
+				   unsigned int len)
+{
+	u32 *dst32 = (u32 *)dst;
+	const u32 *src32 = (const u32 *)src;
+	const u32 *ks32 = (const u32 *)ks;
+	unsigned int words = len / sizeof(u32);
+	unsigned int tail = len % sizeof(u32);
+	unsigned int i;
+
+	if (IS_ALIGNED((unsigned long)dst, sizeof(u32)) &&
+	    IS_ALIGNED((unsigned long)src, sizeof(u32)) &&
+	    IS_ALIGNED((unsigned long)ks, sizeof(u32))) {
+		while (words >= 8) {
+			dst32[0] = src32[0] ^ ks32[0];
+			dst32[1] = src32[1] ^ ks32[1];
+			dst32[2] = src32[2] ^ ks32[2];
+			dst32[3] = src32[3] ^ ks32[3];
+			dst32[4] = src32[4] ^ ks32[4];
+			dst32[5] = src32[5] ^ ks32[5];
+			dst32[6] = src32[6] ^ ks32[6];
+			dst32[7] = src32[7] ^ ks32[7];
+
+			dst32 += 8;
+			src32 += 8;
+			ks32 += 8;
+			words -= 8;
+		}
+
+		while (words--)
+			*dst32++ = *src32++ ^ *ks32++;
+
+		dst = (u8 *)dst32;
+		src = (const u8 *)src32;
+		ks = (const u8 *)ks32;
+	} else {
+		tail = len;
+	}
+
+	for (i = 0; i < tail; i++)
+		dst[i] = src[i] ^ ks[i];
+}
+
+static inline bool ingenic_aes_xor_copy_needs_warn(const void *dst,
+						   const void *src,
+						   unsigned int len)
+{
+	unsigned long dst_addr = (unsigned long)dst;
+	unsigned long src_addr = (unsigned long)src;
+
+	if (!len || dst_addr == src_addr)
+		return false;
+
+	if (dst_addr <= src_addr)
+		return false;
+
+	return dst_addr - src_addr < INGENIC_AES_XOR_PREFETCH_BYTES;
+}
+
+#ifdef CONFIG_MIPS
+static void ingenic_aes_xor_copy(u8 *dst, const u8 *src, const u8 *ks,
+				 unsigned int len)
+{
+	unsigned int blocks;
+	unsigned int tail;
+
+	if (WARN_ON_ONCE(ingenic_aes_xor_copy_needs_warn(dst, src, len)))
+		pr_warn_ratelimited("ingenic-aes: xor_copy overlap dst=%px src=%px ks=%px len=%u\n",
+				    dst, src, ks, len);
+
+	if (!IS_ALIGNED((unsigned long)dst, sizeof(u32)) ||
+	    !IS_ALIGNED((unsigned long)src, sizeof(u32)) ||
+	    !IS_ALIGNED((unsigned long)ks, sizeof(u32))) {
+		ingenic_aes_xor_copy_c(dst, src, ks, len);
+		return;
+	}
+
+	blocks = len / 16;
+	tail = len % 16;
+
+	while (blocks--) {
+		u32 a0, a1, a2, a3;
+		u32 b0, b1, b2, b3;
+
+		asm volatile (
+			"pref 0, 128(%[src])		\n\t"
+			"pref 0, 128(%[ks])		\n\t"
+			"lw   %[a0],  0(%[src])		\n\t"
+			"lw   %[a1],  4(%[src])		\n\t"
+			"lw   %[a2],  8(%[src])		\n\t"
+			"lw   %[a3], 12(%[src])		\n\t"
+			"lw   %[b0],  0(%[ks])		\n\t"
+			"lw   %[b1],  4(%[ks])		\n\t"
+			"lw   %[b2],  8(%[ks])		\n\t"
+			"lw   %[b3], 12(%[ks])		\n\t"
+			"xor  %[a0], %[a0], %[b0]	\n\t"
+			"xor  %[a1], %[a1], %[b1]	\n\t"
+			"xor  %[a2], %[a2], %[b2]	\n\t"
+			"xor  %[a3], %[a3], %[b3]	\n\t"
+			"sw   %[a0],  0(%[dst])		\n\t"
+			"sw   %[a1],  4(%[dst])		\n\t"
+			"sw   %[a2],  8(%[dst])		\n\t"
+			"sw   %[a3], 12(%[dst])		\n\t"
+			: [a0] "=&r" (a0), [a1] "=&r" (a1),
+			  [a2] "=&r" (a2), [a3] "=&r" (a3),
+			  [b0] "=&r" (b0), [b1] "=&r" (b1),
+			  [b2] "=&r" (b2), [b3] "=&r" (b3)
+			: [dst] "r" (dst), [src] "r" (src), [ks] "r" (ks)
+			: "memory"
+		);
+
+		dst += 16;
+		src += 16;
+		ks += 16;
+	}
+
+	while (tail--)
+		*dst++ = *src++ ^ *ks++;
+}
+#else
+static void ingenic_aes_xor_copy(u8 *dst, const u8 *src, const u8 *ks,
+				 unsigned int len)
+{
+	ingenic_aes_xor_copy_c(dst, src, ks, len);
+}
+#endif
+
+static int ingenic_aes_ctr_xor_sg(struct skcipher_request *req,
+				  int src_nents, int dst_nents,
+				  const u8 *keystream, unsigned int len,
+				  unsigned int offset)
+{
+	struct sg_mapping_iter src_iter;
+	struct sg_mapping_iter dst_iter;
+	unsigned int done = 0;
+	int err = 0;
+
+	sg_miter_start(&src_iter, req->src, src_nents, SG_MITER_FROM_SG);
+	sg_miter_start(&dst_iter, req->dst, dst_nents, SG_MITER_TO_SG);
+
+	if (!sg_miter_skip(&src_iter, offset) ||
+	    !sg_miter_skip(&dst_iter, offset)) {
+		err = -EINVAL;
+		goto out;
+	}
+
+	while (done < len) {
+		unsigned int todo = len - done;
+		unsigned int n;
+
+		if (!sg_miter_next(&src_iter) || !sg_miter_next(&dst_iter)) {
+			err = -EINVAL;
+			break;
+		}
+
+		n = min3(src_iter.length, dst_iter.length, (size_t)todo);
+		if (WARN_ON_ONCE(!n || !src_iter.length || !dst_iter.length)) {
+			err = -EIO;
+			break;
+		}
+
+		if (WARN_ON_ONCE(ingenic_aes_xor_copy_needs_warn(dst_iter.addr,
+							    src_iter.addr, n)))
+			pr_warn_ratelimited("ingenic-aes: ctr_xor_sg overlap offset=%u done=%u len=%u src=%p dst=%p n=%u\n",
+					    offset, done, len, src_iter.addr,
+					    dst_iter.addr, n);
+		ingenic_aes_xor_copy(dst_iter.addr, src_iter.addr,
+				     keystream + done, n);
+
+		src_iter.consumed = n;
+		dst_iter.consumed = n;
+		done += n;
+	}
+
+out:
+	sg_miter_stop(&dst_iter);
+	sg_miter_stop(&src_iter);
+
+	return err;
+}
+
+static void ingenic_aes_ctr_profile_add(struct ingenic_aes_dev *aes,
+					u64 fill_ns, u64 dma_ns, u64 xor_ns,
+					unsigned int bytes)
+{
+	aes->ctr_profile_fill_ns += fill_ns;
+	aes->ctr_profile_dma_ns += dma_ns;
+	aes->ctr_profile_xor_ns += xor_ns;
+	aes->ctr_profile_bytes += bytes;
+
+	if (++aes->ctr_profile_chunks >= INGENIC_AES_CTR_PROFILE_CHUNKS) {
+		if (profile) {
+			dev_info(aes->dev,
+				 "CTR profile chunks=%u bytes=%llu fill=%lluns dma=%lluns xor=%lluns\n",
+				 aes->ctr_profile_chunks,
+				 (unsigned long long)aes->ctr_profile_bytes,
+				 (unsigned long long)aes->ctr_profile_fill_ns,
+				 (unsigned long long)aes->ctr_profile_dma_ns,
+				 (unsigned long long)aes->ctr_profile_xor_ns);
+		}
+
+		aes->ctr_profile_fill_ns = 0;
+		aes->ctr_profile_dma_ns = 0;
+		aes->ctr_profile_xor_ns = 0;
+		aes->ctr_profile_bytes = 0;
+		aes->ctr_profile_chunks = 0;
+	}
+}
+
+static int ingenic_aes_ctr_crypt(struct skcipher_request *req)
+{
+	struct crypto_skcipher *tfm = crypto_skcipher_reqtfm(req);
+	struct ingenic_aes_ctx *ctx = crypto_skcipher_ctx(tfm);
+	struct ingenic_aes_dev *aes = ctx->aes;
+	struct {
+		unsigned int offset;
+		unsigned int chunk;
+		unsigned int keystream_len;
+		u64 fill_ns;
+		u64 dma_start_ns;
+	} slot[INGENIC_AES_DMA_SLOTS];
+	unsigned int next_offset = 0;
+	unsigned int cur = 0;
+	int src_nents, dst_nents;
+	int err = 0;
+
+	if (!aes)
+		return -ENODEV;
+
+	if (!req->cryptlen)
+		return 0;
+
+	src_nents = sg_nents_for_len(req->src, req->cryptlen);
+	if (src_nents < 0)
+		return src_nents;
+
+	dst_nents = sg_nents_for_len(req->dst, req->cryptlen);
+	if (dst_nents < 0)
+		return dst_nents;
+
+	mutex_lock(&aes->lock);
+
+#if 1
+	err = clk_prepare_enable(aes->clk_aes);
+	if (err) {
+		dev_err(aes->dev, "failed to enable AES clock: %d\n", err);
+		goto out_unlock;
+	}
+
+	err = clk_prepare_enable(aes->clk_pdma);
+	if (err) {
+		dev_err(aes->dev, "failed to enable PDMA clock: %d\n", err);
+		goto out_disable_aes;
+	}
+#endif
+
+	err = ingenic_aes_prepare(aes, ctx, NULL, INGENIC_AES_MODE_ECB);
+	if (err) {
+		dev_err(aes->dev, "failed to prepare CTR keystream keylen=%u: %d\n",
+			ctx->keylen, err);
+		goto out_stop;
+	}
+
+	slot[cur].offset = next_offset;
+	slot[cur].chunk = min_t(unsigned int, req->cryptlen - next_offset,
+				INGENIC_AES_BUF_SIZE);
+	slot[cur].keystream_len = ALIGN(slot[cur].chunk, AES_BLOCK_SIZE);
+	{
+		u64 t0 = ktime_get_ns();
+
+		ingenic_aes_sync_input_for_cpu(aes, cur,
+						       slot[cur].keystream_len);
+		ingenic_aes_ctr_fill_counter_blocks(aes->buf_in[cur], req->iv,
+						    slot[cur].keystream_len);
+		slot[cur].fill_ns = ktime_get_ns() - t0;
+	}
+	dma_wmb();
+	err = ingenic_aes_dma_start(aes, cur, slot[cur].keystream_len);
+	if (err)
+		goto out_stop;
+
+	slot[cur].dma_start_ns = ktime_get_ns();
+	next_offset += slot[cur].chunk;
+
+	for (;;) {
+		unsigned int next = cur ^ 1;
+		bool next_ready = false;
+		u64 dma_done_ns;
+		u64 xor_start_ns;
+		u64 xor_ns;
+		int start_err = 0;
+
+		if (next_offset < req->cryptlen) {
+			u64 t0;
+
+			slot[next].offset = next_offset;
+			slot[next].chunk = min_t(unsigned int,
+						 req->cryptlen - next_offset,
+						 INGENIC_AES_BUF_SIZE);
+			slot[next].keystream_len = ALIGN(slot[next].chunk,
+							 AES_BLOCK_SIZE);
+
+			t0 = ktime_get_ns();
+			ingenic_aes_sync_input_for_cpu(aes, next,
+						       slot[next].keystream_len);
+			ingenic_aes_ctr_fill_counter_blocks(aes->buf_in[next],
+							    req->iv,
+							    slot[next].keystream_len);
+			slot[next].fill_ns = ktime_get_ns() - t0;
+			dma_wmb();
+			next_offset += slot[next].chunk;
+			next_ready = true;
+		}
+
+		err = ingenic_aes_dma_wait(aes);
+		dma_done_ns = ktime_get_ns();
+		if (err) {
+			dev_err(aes->dev,
+				"CTR keystream DMA failed cryptlen=%u offset=%u chunk=%u keystream=%u: %d\n",
+				req->cryptlen, slot[cur].offset, slot[cur].chunk,
+				slot[cur].keystream_len, err);
+			break;
+		}
+
+		if (next_ready) {
+			start_err = ingenic_aes_dma_start(aes, next,
+							 slot[next].keystream_len);
+			if (start_err)
+				next_ready = false;
+			else
+				slot[next].dma_start_ns = ktime_get_ns();
+		}
+
+		ingenic_aes_sync_output_for_cpu(aes, cur,
+						slot[cur].keystream_len);
+		xor_start_ns = ktime_get_ns();
+		err = ingenic_aes_ctr_xor_sg(req, src_nents, dst_nents,
+					     aes->buf_out[cur],
+					     slot[cur].chunk,
+					     slot[cur].offset);
+		xor_ns = ktime_get_ns() - xor_start_ns;
+		if (err) {
+			if (next_ready)
+				ingenic_aes_dma_wait(aes);
+			break;
+		}
+
+		ingenic_aes_ctr_profile_add(aes, slot[cur].fill_ns,
+					    dma_done_ns - slot[cur].dma_start_ns,
+					    xor_ns, slot[cur].chunk);
+
+		if (start_err)
+			err = start_err;
+
+		if (err || !next_ready)
+			break;
+
+		cur = next;
+	}
+
+out_stop:
+	ingenic_aes_stop(aes);
+#if 1
+	clk_disable_unprepare(aes->clk_pdma);
+out_disable_aes:
+	clk_disable_unprepare(aes->clk_aes);
+#endif
+out_unlock:
+	mutex_unlock(&aes->lock);
+
+	return err;
+}
+
+static int ingenic_aes_setkey_common(struct ingenic_aes_ctx *ctx,
+				     const u8 *key, unsigned int keylen)
+{
+	if (keylen != AES_KEYSIZE_128 && keylen != AES_KEYSIZE_192 &&
+	    keylen != AES_KEYSIZE_256)
+		return -EINVAL;
+
+	memcpy(ctx->key, key, keylen);
+	ctx->keylen = keylen;
+
+	return 0;
+}
+
+static int ingenic_aes_setkey(struct crypto_skcipher *tfm, const u8 *key,
+			      unsigned int keylen)
+{
+	return ingenic_aes_setkey_common(crypto_skcipher_ctx(tfm), key, keylen);
+}
+
+static int ingenic_aes_ecb_encrypt(struct skcipher_request *req)
+{
+	return ingenic_aes_crypt(req, INGENIC_AES_MODE_ECB);
+}
+
+static int ingenic_aes_ecb_decrypt(struct skcipher_request *req)
+{
+	return ingenic_aes_crypt(req, INGENIC_AES_MODE_ECB | INGENIC_AES_DECRYPT);
+}
+
+static int ingenic_aes_cbc_encrypt(struct skcipher_request *req)
+{
+	return ingenic_aes_crypt(req, INGENIC_AES_MODE_CBC);
+}
+
+static int ingenic_aes_cbc_decrypt(struct skcipher_request *req)
+{
+	return ingenic_aes_crypt(req, INGENIC_AES_MODE_CBC | INGENIC_AES_DECRYPT);
+}
+
+static int ingenic_aes_init_tfm(struct crypto_skcipher *tfm)
+{
+	struct ingenic_aes_ctx *ctx = crypto_skcipher_ctx(tfm);
+
+	ctx->aes = ingenic_aes_dd;
+
+	return ctx->aes ? 0 : -ENODEV;
+}
