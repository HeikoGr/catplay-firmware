Date: Sun, 8 Feb 2026 20:12:42 +0100
Subject: [PATCH 2/2] Fix boot crash in Falcon mode (U-Boot SPL -> uzImage self-decompressor -> kernel jump)

---
 arch/mips/boot/compressed/decompress.c |   3 +-
 arch/mips/boot/compressed/head.S       | 113 +++++++++++++++++++++++--
 arch/mips/boot/compressed/ld.script    |   5 +-
 arch/mips/ingenic/Platform             |   2 +-
 4 files changed, 111 insertions(+), 12 deletions(-)

diff --git a/arch/mips/boot/compressed/decompress.c b/arch/mips/boot/compressed/decompress.c
index 90021c6a8..2f30c74bc 100644
--- a/arch/mips/boot/compressed/decompress.c
+++ b/arch/mips/boot/compressed/decompress.c
@@ -124,6 +124,5 @@ void decompress_kernel(unsigned long boot_heap_start)
 		       __appended_dtb, dtb_size);
 	}
 
-	/* FIXME: should we flush cache here? */
-	puts("Now, booting the kernel...\n");
+	puts("Now, flushing cache and booting the kernel...\n");
 }
diff --git a/arch/mips/boot/compressed/head.S b/arch/mips/boot/compressed/head.S
index d237a834b..7b02839a5 100644
--- a/arch/mips/boot/compressed/head.S
+++ b/arch/mips/boot/compressed/head.S
@@ -14,8 +14,43 @@
 
 #include <asm/asm.h>
 #include <asm/regdef.h>
+#include <asm/addrspace.h>
+#include <linux/kconfig.h>
+#include <linux/types.h>
+#include <linux/serial_reg.h>
 
+.set noreorder
+
+.macro UART_BASE reg
+    lui \reg, 0xB003
+    ori \reg, \reg, 0x2000
+.endm
+
+.macro UART_PUTC char_reg
+    UART_BASE t0
+    andi    \char_reg, \char_reg, 0xff
+    sw      \char_reg, 0(t0)
+.endm
+
+.macro UART_PUTC_WAIT char_reg
+    UART_BASE t0
+
+1:
+	lw    t1, 0x14(t0)  
+	andi  t1, t1, 0x20
+	beqz  t1, 1b
+	 nop
+
+    andi    \char_reg, \char_reg, 0xff
+    sw      \char_reg, 0(t0)
+.endm
+
+	/* .cprestore */
 	LEAF(start)
+
+    li      t2, 'B'
+    UART_PUTC t2
+
 	/* Save boot rom start args */
 	move	s0, a0
 	move	s1, a1
@@ -28,24 +63,86 @@
 1:	PTR_S	zero, 0(a0)
 	PTR_ADDIU a0, a0, PTRSIZE
 	bne	a2, a0, 1b
+	 nop
 
 	PTR_LA	a0, (.heap)	     /* heap address */
 	PTR_LA	sp, (.stack + 8192)  /* stack address */
 
+    li      t2, '^'
+    UART_PUTC t2
+
 	PTR_LA	t9, decompress_kernel
 	jalr	t9
+	 nop
+
+__after_decompress:
+    li      t2, '@'
+    UART_PUTC t2
+
+	/* set target values for __fc_loop */
+	lui	k0, 0x8000
+	lui	k1, 0x8000
+	ori	k1, k1, 0x8000
+
+	/* jump to __fc_loop via uncached (0xA000 prefix) */
+	lui	t0, %hi(__fc_loop)
+	addiu	t0, t0, %lo(__fc_loop)
+	lui	t1, 0xA000
+	or	t0, t0, t1
+	jr.hb	t0
+	 nop
+	 
+__fc_loop:
+	cache	1, 0x00(k0)
+	cache	1, 0x20(k0)
+	cache	1, 0x40(k0)
+	cache	1, 0x60(k0)
 
-2:
-	move	a0, s0
-	move	a1, s1
-	move	a2, s2
-	move	a3, s3
+	cache	0, 0x00(k0)
+	cache	0, 0x20(k0)
+	cache	0, 0x40(k0)
+	cache	0, 0x60(k0)
+
+	addiu	k0, k0, 0x80
+	bne	k0, k1, __fc_loop
+	 nop
+
+    li      t2, '#'
+    UART_PUTC t2
+
+	/* jump to __start_kernel via cached (0x80F0) */
+	sync
+
+	li      t2, '%'
+    UART_PUTC t2
+
+	lui	t0, %hi(__start_kernel)
+	addiu	t0, t0, %lo(__start_kernel)
+
+	jr.hb	t0
+	 nop
+
+__start_kernel:
+	/* restore registers */
+	move	a0, s0 /* $0 */
+	move	a1, s1 /* $0 */
+	move	a2, s2 /* $0 */
+	move	a3, s3 /* $0 */
+
+    li      t2, 'J'
+    UART_PUTC t2
+
+	/* jump to kernel via cached (0x80F0) */
 	PTR_LI	t9, KERNEL_ENTRY
-	jalr	t9
+	jalr.hb	t9
+	 nop
 
+    li      t2, '?'
+    UART_PUTC t2
 3:
-	b	3b
-
+	/* if the jump did nothing, enter an endless loop */
+	b 3b
+	 nop
 	END(start)
 
 	.comm .heap,BOOT_HEAP_SIZE,4
diff --git a/arch/mips/boot/compressed/ld.script b/arch/mips/boot/compressed/ld.script
index 0ebb66727..9b06b7cbe 100644
--- a/arch/mips/boot/compressed/ld.script
+++ b/arch/mips/boot/compressed/ld.script
@@ -22,6 +22,7 @@ SECTIONS
 	/* End of text section */
 
 	/* Writable data */
+	. = ALIGN(16);
 	.data : {
 		*(.data)
 		/* Put the compressed image here */
@@ -31,6 +32,7 @@ SECTIONS
 		CONSTRUCTORS
 		. = ALIGN(16);
 	}
+	. = ALIGN(16);
 
 	.appended_dtb : {
 		__appended_dtb = .;
@@ -38,6 +40,7 @@ SECTIONS
 		. += 0x100000;
 	}
 
+	. = ALIGN(16);
 	_edata = .;
 	/* End of data section */
 
@@ -57,4 +60,4 @@ SECTIONS
 		*(.comment)
 		*(.note)
 	}
-}
+}
\ No newline at end of file
diff --git a/arch/mips/ingenic/Platform b/arch/mips/ingenic/Platform
index 1334e8c14..bc855732d 100644
--- a/arch/mips/ingenic/Platform
+++ b/arch/mips/ingenic/Platform
@@ -1,2 +1,2 @@
-load-$(CONFIG_MACH_X1600)	:= 0xffffffff80010000
+load-$(CONFIG_MACH_X1600)	:= 0xffffffff80010000
 load-$(CONFIG_MACH_X2000)	:= 0xffffffff80010000
-- 
2.52.0
