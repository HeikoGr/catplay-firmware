Subject: [PATCH] dwc2: log port connect/enable/overcurrent interrupts

Upstream-Status: Pending

Diagnostic aid for catplay-firmware issue #1: on some head units, the
device stays in USB host mode (after an iAP2/CarPlay role-switch
request) for the full accessory-probe window without the driver ever
detecting an accessory. These dwc2_port_intr() messages were
dev_vdbg, so they never showed up without dynamic debug. Promote them
to dev_info, matching 0022's treatment of wait_for_mode/force_mode,
so a normal dmesg capture during that window shows whether *any*
electrical port activity (connect/enable/overcurrent) happens at all.

---
 drivers/usb/dwc2/hcd_intr.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/usb/dwc2/hcd_intr.c b/drivers/usb/dwc2/hcd_intr.c
index 375e543d5f73..1a2b3c4d5e6f 100644
--- a/drivers/usb/dwc2/hcd_intr.c
+++ b/drivers/usb/dwc2/hcd_intr.c
@@ -327,7 +327,7 @@ static void dwc2_port_intr(struct dwc2_hsotg *hsotg)
 	u32 hprt0;
 	u32 hprt0_modify;

-	dev_vdbg(hsotg->dev, "--Port Interrupt--\n");
+	dev_info(hsotg->dev, "--Port Interrupt--\n");

 	hprt0 = dwc2_readl(hsotg, HPRT0);
 	hprt0_modify = hprt0;
@@ -346,7 +346,7 @@ static void dwc2_port_intr(struct dwc2_hsotg *hsotg)
 	if (hprt0 & HPRT0_CONNDET) {
 		dwc2_writel(hsotg, hprt0_modify | HPRT0_CONNDET, HPRT0);

-		dev_vdbg(hsotg->dev,
+		dev_info(hsotg->dev,
 			 "--Port Interrupt HPRT0=0x%08x Port Connect Detected--\n",
 			 hprt0);
 		dwc2_hcd_connect(hsotg);
@@ -363,7 +363,7 @@ static void dwc2_port_intr(struct dwc2_hsotg *hsotg)
 	 */
 	if (hprt0 & HPRT0_ENACHG) {
 		dwc2_writel(hsotg, hprt0_modify | HPRT0_ENACHG, HPRT0);
-		dev_vdbg(hsotg->dev,
+		dev_info(hsotg->dev,
 			 "  --Port Interrupt HPRT0=0x%08x Port Enable Changed (now %d)--\n",
 			 hprt0, !!(hprt0 & HPRT0_ENA));
 		if (hprt0 & HPRT0_ENA) {
@@ -387,7 +387,7 @@ static void dwc2_port_intr(struct dwc2_hsotg *hsotg)
 	if (hprt0 & HPRT0_OVRCURRCHG) {
 		dwc2_writel(hsotg, hprt0_modify | HPRT0_OVRCURRCHG,
 			    HPRT0);
-		dev_vdbg(hsotg->dev,
+		dev_info(hsotg->dev,
 			 "  --Port Interrupt HPRT0=0x%08x Port Overcurrent Changed--\n",
 			 hprt0);
 		hsotg->flags.b.port_over_current_change = 1;
--
2.53.0
