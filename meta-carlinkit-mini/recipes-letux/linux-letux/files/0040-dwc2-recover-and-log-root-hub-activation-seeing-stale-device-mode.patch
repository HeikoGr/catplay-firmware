Subject: [PATCH] dwc2: recover and log root-hub activation seeing stale device mode
Upstream-Status: Pending

_dwc2_hcd_start() ("Starts the HCD when switching to Host mode") had this
check right at the top:

	if (dwc2_is_device_mode(hsotg)) {
		spin_unlock_irqrestore(&hsotg->lock, flags);
		return 0;	/* why 0 ?? */
	}

- an unexplained, entirely silent early return (no log of any kind) that
skips dwc2_hcd_reinit(), dwc2_vbus_supply_init() and, critically,
usb_hcd_resume_root_hub() - i.e. the root hub is never activated and the
host controller's interrupts (port connect/enable/overcurrent, see patch
0038) never get enabled, with nothing in dmesg to explain why.

hsotg->wq_otg is an *ordered* workqueue (alloc_ordered_workqueue() in
dwc2_hcd_init()), so this function - queued as hsotg->start_work by
dwc2_hcd_start() - cannot run concurrently with
dwc2_conn_id_status_change(): it only runs after the "A-Device"/host
branch that queued it has already returned, i.e. after
dwc2_core_init()->dwc2_core_reset()->dwc2_wait_for_mode() has already
synchronously confirmed host mode. So dwc2_is_device_mode(hsotg) should
normally never be true here - the most plausible way it becomes true
anyway is a second, spurious Connector ID Status Change interrupt queuing
another dwc2_conn_id_status_change() job on the same ordered queue ahead
of start_work, which (if it takes the B-Device/device branch) flips the
mode back before start_work gets its turn.

Captured dmesg from a real role-switch on this hardware (Carlinkit Mini
Ultra dongle, Ingenic X1600, wired to a Toyota Proace Verso NAC Wave 2
head unit) already shows two independent, racing dwc2_wait_for_mode(host)
calls around the same force_mode(host) request (see patch
0039-dwc2-skip-redundant-racing-wait_for_mode-on-role-switch-platforms.patch),
and separately shows zero HPRT0 port-connect/enable/overcurrent interrupt
activity for the entire accessory-probe window afterwards, consistent
with the root hub never actually getting activated. This silent
early-return in _dwc2_hcd_start() is a concrete, code-level mechanism
that would fully explain that symptom without requiring any electrical
glitch (VBUS/PHY) at all - the previous "maybe VBUS glitches during the
core reset" theory doesn't hold up: dwc2_vbus_supply_init()/_exit() are
only ever called from usbcore's own hub-driven root-hub port-power
sequence (SetPortFeature/USB_PORT_FEAT_POWER handling and
_dwc2_hcd_start()/_dwc2_hcd_stop() themselves) - nothing in
dwc2_core_reset()/dwc2_conn_id_status_change() touches the vbus_supply
regulator, and a real VBUS interruption to the SoC's own supply would
have to restart the whole board (this dongle has no independent power
source), which the continuous, unbroken dmesg timestamps across the
mode-switch rule out.

This patch:

 1. Promotes dwc2_conn_id_status_change()'s entry/branch/hand-off logging
    from dev_dbg to dev_info (matching the visibility level already used
    by patches 0021-0023/0038), so a normal (non-debug) capture shows how
    many times it runs per role-switch and what GOTGCTL/mode state it
    sees each time - needed to actually confirm or rule out the
    double-interrupt theory above from a real capture.

 2. Replaces the silent return 0 in _dwc2_hcd_start() with: a loud
    dev_warn identifying exactly what happened, a bounded retry (up to
    200ms, matching the worst-case mode-switch time measured on this
    hardware) instead of giving up immediately, and either a dev_info
    confirming recovery or a dev_err making the permanent failure visible
    in dmesg instead of silent.

---
 drivers/usb/dwc2/hcd.c | 68 +++++++++++++++++++++++++++++++++++++++++-------
 1 file changed, 59 insertions(+), 9 deletions(-)

diff --git a/drivers/usb/dwc2/hcd.c b/drivers/usb/dwc2/hcd.c
index 651644eab..7c4a8f9d1 100644
--- a/drivers/usb/dwc2/hcd.c
+++ b/drivers/usb/dwc2/hcd.c
@@ -16,6 +16,7 @@
 #include <linux/platform_device.h>
 #include <linux/dma-mapping.h>
 #include <linux/delay.h>
+#include <linux/jiffies.h>
 #include <linux/io.h>
 #include <linux/slab.h>
 #include <linux/usb.h>
@@ -3142,12 +3143,9 @@ static void dwc2_conn_id_status_change(struct work_struct *work)
 	u32 gotgctl;
 	unsigned long flags;

-	dev_dbg(hsotg->dev, "%s()\n", __func__);
-
 	gotgctl = dwc2_readl(hsotg, GOTGCTL);
-	dev_dbg(hsotg->dev, "gotgctl=%0x\n", gotgctl);
-	dev_dbg(hsotg->dev, "gotgctl.b.conidsts=%d\n",
-		!!(gotgctl & GOTGCTL_CONID_B));
+	dev_info(hsotg->dev, "%s(): GOTGCTL=%08x conidsts=%d\n", __func__,
+		 gotgctl, !!(gotgctl & GOTGCTL_CONID_B));

 	/* B-Device connector (Device Mode) */
 	if (gotgctl & GOTGCTL_CONID_B) {
@@ -3200,7 +3198,8 @@ static void dwc2_conn_id_status_change(struct work_struct *work)
 	} else {
 host:
 		/* A-Device connector (Host Mode) */
-		dev_dbg(hsotg->dev, "connId A\n");
+		dev_info(hsotg->dev, "connId A (GOTGCTL=%08x)\n",
+			 dwc2_readl(hsotg, GOTGCTL));
 		while (!dwc2_is_host_mode(hsotg)) {
 			dev_info(hsotg->dev, "Waiting for Host Mode, Mode=%s\n",
 				 dwc2_is_host_mode(hsotg) ?
@@ -3221,6 +3220,9 @@ static void dwc2_conn_id_status_change(struct work_struct *work)
 		/* Initialize the Core for Host mode */
 		dwc2_core_init(hsotg, false);
 		dwc2_enable_global_interrupts(hsotg);
+		dev_info(hsotg->dev,
+			 "connId A: core reinit done, mode=%s, starting HCD\n",
+			 dwc2_is_host_mode(hsotg) ? "host" : "device");
 		dwc2_hcd_start(hsotg);
 	}
 }
@@ -4252,7 +4254,8 @@ static int _dwc2_hcd_start(struct usb_hcd *hcd)
 	u32 hprt0;
 	int ret;

-	dev_dbg(hsotg->dev, "DWC OTG HCD START\n");
+	dev_info(hsotg->dev, "DWC OTG HCD START (mode=%s)\n",
+		 dwc2_is_host_mode(hsotg) ? "host" : "device");

 	spin_lock_irqsave(&hsotg->lock, flags);
 	hsotg->lx_state = DWC2_L0;
@@ -4260,8 +4263,54 @@ static int _dwc2_hcd_start(struct usb_hcd *hcd)
 	set_bit(HCD_FLAG_HW_ACCESSIBLE, &hcd->flags);

 	if (dwc2_is_device_mode(hsotg)) {
+		unsigned long timeout;
+
 		spin_unlock_irqrestore(&hsotg->lock, flags);
-		return 0;	/* why 0 ?? */
+
+		/*
+		 * Normally mode should already be host here: this function
+		 * only runs (queued via hsotg->start_work, on the ordered
+		 * hsotg->wq_otg workqueue) after
+		 * dwc2_conn_id_status_change()'s "A-Device"/host branch has
+		 * already synchronously confirmed host mode via
+		 * dwc2_core_init()->dwc2_core_reset()->dwc2_wait_for_mode().
+		 * Seeing device mode here means something flipped the mode
+		 * back in between - e.g. a second, spurious Connector ID
+		 * Status Change interrupt queuing another
+		 * dwc2_conn_id_status_change() job ahead of this one on the
+		 * same ordered workqueue. This used to silently return 0
+		 * without ever activating the root hub, leaving the host
+		 * controller's interrupts (port connect/enable/overcurrent)
+		 * disabled for good with no indication why. Retry for a
+		 * bounded time (matching the ~200ms worst-case mode-switch
+		 * time measured on this hardware) before giving up.
+		 */
+		dev_warn(hsotg->dev,
+			 "%s: unexpectedly in device mode (GOTGCTL=%08x GINTSTS=%08x) "
+			 "when activating the root hub - retrying for up to 200ms\n",
+			 __func__, dwc2_readl(hsotg, GOTGCTL),
+			 dwc2_readl(hsotg, GINTSTS));
+
+		timeout = jiffies + msecs_to_jiffies(200);
+		while (dwc2_is_device_mode(hsotg) && time_before(jiffies, timeout))
+			usleep_range(1000, 2000);
+
+		spin_lock_irqsave(&hsotg->lock, flags);
+
+		if (dwc2_is_device_mode(hsotg)) {
+			dev_err(hsotg->dev,
+				"%s: still in device mode after 200ms retry - "
+				"root hub will NOT be activated, host-controller "
+				"interrupts stay disabled (GOTGCTL=%08x GINTSTS=%08x)\n",
+				__func__, dwc2_readl(hsotg, GOTGCTL),
+				dwc2_readl(hsotg, GINTSTS));
+			spin_unlock_irqrestore(&hsotg->lock, flags);
+			return 0;	/* why 0 ?? */
+		}
+
+		dev_info(hsotg->dev,
+			 "%s: recovered host mode after retry, continuing root hub activation\n",
+			 __func__);
 	}

 	dwc2_hcd_reinit(hsotg);
--
2.55.0
