Subject: [PATCH] jz4740_mmc: fix broken compat with aic8800

diff --git a/drivers/mmc/host/jz4740_mmc.c b/drivers/mmc/host/jz4740_mmc.c
index b19d0c8eb..90ac5e7e4 100644
--- a/drivers/mmc/host/jz4740_mmc.c
+++ b/drivers/mmc/host/jz4740_mmc.c
@@ -15,7 +15,9 @@
 #include <linux/interrupt.h>
 #include <linux/io.h>
 #include <linux/irq.h>
+#include <linux/mmc/card.h>
 #include <linux/mmc/host.h>
+#include <linux/mmc/sdio.h>
 #include <linux/mmc/slot-gpio.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -112,6 +114,11 @@
 #define JZ_MMC_CLK_RATE 24000000
 #define JZ_MMC_REQ_TIMEOUT_MS 5000
 
+#define JZ_MMC_CMD53_RETRIES 1
+#define JZ_MMC_DEFAULT_RESTO 0xff
+#define JZ_MMC_DEFAULT_RDTO 0x00ffffff
+#define JZ_MMC_CLKRT0_MIN_RATE 3000000
+
 enum jz4740_mmc_version {
 	JZ_MMC_JZ4730,
 	JZ_MMC_JZ4740,
@@ -162,6 +169,9 @@ struct jz4740_mmc_host {
 	struct mmc_command *cmd;
 
 	bool vqmmc_enabled;
+	bool force_clkrt0_for_rw;
+	bool is_sdio_card;
+	bool force_pio;
 
 	unsigned long waiting;
 
@@ -501,6 +511,13 @@ static unsigned int jz4740_mmc_poll_irq(struct jz4740_mmc_host *host,
 	} while (!(status & irq) && --timeout);
 
 	if (timeout == 0) {
+		if (host->req && host->req->cmd) {
+			dev_dbg(&host->pdev->dev,
+				 "poll_irq timeout: wait=0x%08x cmd=%u arg=0x%08x state=%d stat=0x%08x iflg=0x%08x\n",
+				 irq, host->req->cmd->opcode, host->req->cmd->arg,
+				 host->state, readl(host->base + JZ_REG_MMC_STATUS),
+				 jz4740_mmc_read_irq_reg(host));
+		}
 		set_bit(0, &host->waiting);
 		mod_timer(&host->timeout_timer,
 			  jiffies + msecs_to_jiffies(JZ_MMC_REQ_TIMEOUT_MS));
@@ -525,6 +542,12 @@ static void jz4740_mmc_transfer_check_state(struct jz4740_mmc_host *host,
 			host->req->cmd->error = -EIO;
 			data->error = -EIO;
 		}
+		if (host->req && host->req->cmd) {
+			dev_dbg(&host->pdev->dev,
+				"write error: cmd=%u arg=0x%08x stat=0x%08x iflg=0x%08x\n",
+				host->req->cmd->opcode, host->req->cmd->arg, status,
+				jz4740_mmc_read_irq_reg(host));
+		}
 	} else if (status & JZ_MMC_STATUS_READ_ERROR_MASK) {
 		if (status & (JZ_MMC_STATUS_TIMEOUT_READ)) {
 			host->req->cmd->error = -ETIMEDOUT;
@@ -533,6 +556,12 @@ static void jz4740_mmc_transfer_check_state(struct jz4740_mmc_host *host,
 			host->req->cmd->error = -EIO;
 			data->error = -EIO;
 		}
+		if (host->req && host->req->cmd) {
+			dev_dbg(&host->pdev->dev,
+				"read error: cmd=%u arg=0x%08x stat=0x%08x iflg=0x%08x\n",
+				host->req->cmd->opcode, host->req->cmd->arg, status,
+				jz4740_mmc_read_irq_reg(host));
+		}
 	}
 }
 
@@ -678,7 +707,19 @@ static void jz4740_mmc_timeout(struct timer_list *t)
 
 	jz4740_mmc_set_irq_enabled(host, JZ_MMC_IRQ_END_CMD_RES, false);
 
-	host->req->cmd->error = -ETIMEDOUT;
+	if (host->req && host->req->cmd) {
+		struct mmc_command *cmd = host->req->cmd;
+
+        host->req->cmd->error = -ETIMEDOUT;
+		dev_dbg(&host->pdev->dev,
+			"request timeout: cmd=%u arg=0x%08x state=%d stat=0x%08x iflg=0x%08x clkrt=0x%08x cmdat=0x%08x\n",
+			cmd->opcode, cmd->arg, host->state,
+			readl(host->base + JZ_REG_MMC_STATUS),
+			jz4740_mmc_read_irq_reg(host),
+			readl(host->base + JZ_REG_MMC_CLKRT),
+			readl(host->base + JZ_REG_MMC_CMDAT));
+	}
+
 	jz4740_mmc_request_done(host);
 }
 
@@ -757,8 +798,23 @@ static void jz4740_mmc_send_command(struct jz4740_mmc_host *host,
 			writel(0, host->base + JZ_REG_MMC_DMAC);
 		}
 
-		writew(cmd->data->blksz, host->base + JZ_REG_MMC_BLKLEN);
-		writew(cmd->data->blocks, host->base + JZ_REG_MMC_NOB);
+			writew(cmd->data->blksz, host->base + JZ_REG_MMC_BLKLEN);
+			writew(cmd->data->blocks, host->base + JZ_REG_MMC_NOB);
+	}
+
+	if (cmd->data) {
+		dev_dbg(&host->pdev->dev,
+			"send cmd=%u arg=0x%08x flg=0x%x blksz=%u blocks=%u dataflg=0x%x cmdat=0x%08x clkrt=0x%08x lpm=0x%08x\n",
+			cmd->opcode, cmd->arg, cmd->flags, cmd->data->blksz,
+			cmd->data->blocks, cmd->data->flags, cmdat,
+			readl(host->base + JZ_REG_MMC_CLKRT),
+			readl(host->base + JZ_REG_MMC_LPM));
+	} else {
+		dev_dbg(&host->pdev->dev,
+			"send cmd=%u arg=0x%08x flg=0x%x cmdat=0x%08x clkrt=0x%08x lpm=0x%08x\n",
+			cmd->opcode, cmd->arg, cmd->flags, cmdat,
+			readl(host->base + JZ_REG_MMC_CLKRT),
+			readl(host->base + JZ_REG_MMC_LPM));
 	}
 
 	writeb(cmd->opcode, host->base + JZ_REG_MMC_CMD);
@@ -898,16 +954,25 @@ static irqreturn_t jz_mmc_irq(int irq, void *devid)
 		if (test_and_clear_bit(0, &host->waiting)) {
 			timer_delete(&host->timeout_timer);
 
-			if (status & JZ_MMC_STATUS_TIMEOUT_RES) {
-				cmd->error = -ETIMEDOUT;
-			} else if (status & JZ_MMC_STATUS_CRC_RES_ERR) {
-				cmd->error = -EIO;
-			} else if (status & (JZ_MMC_STATUS_CRC_READ_ERROR |
-				    JZ_MMC_STATUS_CRC_WRITE_ERROR)) {
-				if (cmd->data)
-					cmd->data->error = -EIO;
-				cmd->error = -EIO;
-			}
+				if (status & JZ_MMC_STATUS_TIMEOUT_RES) {
+					cmd->error = -ETIMEDOUT;
+					dev_dbg(&host->pdev->dev,
+						"cmd timeout-res: cmd=%u arg=0x%08x stat=0x%08x iflg=0x%08x\n",
+						cmd->opcode, cmd->arg, status, irq_reg);
+				} else if (status & JZ_MMC_STATUS_CRC_RES_ERR) {
+					cmd->error = -EIO;
+					dev_dbg(&host->pdev->dev,
+						"cmd crc-res: cmd=%u arg=0x%08x stat=0x%08x iflg=0x%08x\n",
+						cmd->opcode, cmd->arg, status, irq_reg);
+				} else if (status & (JZ_MMC_STATUS_CRC_READ_ERROR |
+					    JZ_MMC_STATUS_CRC_WRITE_ERROR)) {
+					if (cmd->data)
+						cmd->data->error = -EIO;
+					cmd->error = -EIO;
+					dev_dbg(&host->pdev->dev,
+						"data crc: cmd=%u arg=0x%08x stat=0x%08x iflg=0x%08x\n",
+						cmd->opcode, cmd->arg, status, irq_reg);
+				}
 
 			jz4740_mmc_set_irq_enabled(host, irq_reg, false);
 			jz4740_mmc_write_irq_reg(host, irq_reg);
@@ -923,34 +988,74 @@ static int jz4740_mmc_set_clock_rate(struct jz4740_mmc_host *host, int rate)
 {
 	int div = 0;
 	int real_rate;
+	u32 lpm = 0;
 
 	jz4740_mmc_clock_disable(host);
-	clk_set_rate(host->clk, host->mmc->f_max);
 
-	real_rate = clk_get_rate(host->clk);
+	if (host->force_clkrt0_for_rw && rate >= JZ_MMC_CLKRT0_MIN_RATE) {
+		/*
+		 * Some Ingenic variants expect CLKRT=0 for normal transfers.
+		 * In that mode, ask CGU for the target clock directly.
+		 */
+		clk_set_rate(host->clk, rate);
+		real_rate = clk_get_rate(host->clk);
+		writew(0, host->base + JZ_REG_MMC_CLKRT);
+	} else {
+		clk_set_rate(host->clk, host->mmc->f_max);
+		real_rate = clk_get_rate(host->clk);
 
-	while (real_rate > rate && div < 7) {
-		++div;
-		real_rate >>= 1;
-	}
+		while (real_rate > rate && div < 7) {
+			++div;
+			real_rate >>= 1;
+		}
 
-	writew(div, host->base + JZ_REG_MMC_CLKRT);
+		writew(div, host->base + JZ_REG_MMC_CLKRT);
+	}
 
 	if (real_rate > 25000000) {
 		if (host->version >= JZ_MMC_JZ4780) {
-			writel(JZ_MMC_LPM_DRV_RISING_QTR_PHASE_DLY |
-				   JZ_MMC_LPM_SMP_RISING_QTR_OR_HALF_PHASE_DLY |
-				   JZ_MMC_LPM_LOW_POWER_MODE_EN,
-				   host->base + JZ_REG_MMC_LPM);
+			lpm = JZ_MMC_LPM_DRV_RISING_QTR_PHASE_DLY;
+			/*
+			 * Match vendor SDIO timing: keep only driver phase select.
+			 * Enabling sample-delay (bit 29) proved unstable for some
+			 * WLAN CMD53 transfers around multi-block boundaries.
+			 */
+			if (!host->is_sdio_card)
+				lpm |= JZ_MMC_LPM_SMP_RISING_QTR_OR_HALF_PHASE_DLY |
+				       JZ_MMC_LPM_LOW_POWER_MODE_EN;
 		} else if (host->version >= JZ_MMC_JZ4760) {
-			writel(JZ_MMC_LPM_DRV_RISING |
-				   JZ_MMC_LPM_LOW_POWER_MODE_EN,
-				   host->base + JZ_REG_MMC_LPM);
-		} else if (host->version >= JZ_MMC_JZ4725B)
-			writel(JZ_MMC_LPM_LOW_POWER_MODE_EN,
-				   host->base + JZ_REG_MMC_LPM);
+			lpm = JZ_MMC_LPM_DRV_RISING |
+			      JZ_MMC_LPM_LOW_POWER_MODE_EN;
+		} else if (host->version >= JZ_MMC_JZ4725B) {
+			lpm = JZ_MMC_LPM_LOW_POWER_MODE_EN;
+		}
+
+		/*
+		 * The original Ingenic driver keeps SDIO in non-LPM sampling mode;
+		 * low-power sampling causes flaky CMD53 transfers on some WLAN
+		 * modules.
+		 */
+		if (host->is_sdio_card)
+			lpm &= ~JZ_MMC_LPM_LOW_POWER_MODE_EN;
+
+		if (host->version >= JZ_MMC_JZ4725B)
+			writel(lpm, host->base + JZ_REG_MMC_LPM);
+	} else if (host->version >= JZ_MMC_JZ4725B) {
+		/*
+		 * Keep timing mode in sync with the selected clock.
+		 * Leaving LPM enabled after switching back to low rate can break
+		 * SDIO transfers on some Ingenic variants.
+		 */
+		writel(0, host->base + JZ_REG_MMC_LPM);
 	}
 
+	/*
+	 * Vendor driver explicitly restarts SDIO clock after LPM/timing changes.
+	 * Some modules need this to survive the first data transactions.
+	 */
+	if (host->is_sdio_card)
+		jz4740_mmc_clock_enable(host, false);
+
 	return real_rate;
 }
 
@@ -958,8 +1063,17 @@ static void jz4740_mmc_request(struct mmc_host *mmc, struct mmc_request *req)
 {
 	struct jz4740_mmc_host *host = mmc_priv(mmc);
 
+	/*
+	 * SDIO CMD53 is used for bulk data path; retrying transient CRC/timeout
+	 * failures avoids wedging the WLAN bootstrap on noisy links.
+	 */
+	if (req->cmd && req->cmd->opcode == SD_IO_RW_EXTENDED && !req->cmd->retries)
+		req->cmd->retries = JZ_MMC_CMD53_RETRIES;
+
 	host->req = req;
 
+	writel(JZ_MMC_DEFAULT_RESTO, host->base + JZ_REG_MMC_RESTO);
+	writel(JZ_MMC_DEFAULT_RDTO, host->base + JZ_REG_MMC_RDTO);
 	jz4740_mmc_write_irq_reg(host, ~0);
 	jz4740_mmc_set_irq_enabled(host, JZ_MMC_IRQ_END_CMD_RES, true);
 
@@ -1028,9 +1142,22 @@ static void jz4740_mmc_set_ios(struct mmc_host *mmc, struct mmc_ios *ios)
 static void jz4740_mmc_enable_sdio_irq(struct mmc_host *mmc, int enable)
 {
 	struct jz4740_mmc_host *host = mmc_priv(mmc);
+
+	/* Match vendor behavior: clear pending SDIO IRQ only when disabling. */
+	if (!enable)
+		jz4740_mmc_write_irq_reg(host, JZ_MMC_IRQ_SDIO);
+
 	jz4740_mmc_set_irq_enabled(host, JZ_MMC_IRQ_SDIO, enable);
 }
 
+static void jz4740_mmc_init_card(struct mmc_host *mmc, struct mmc_card *card)
+{
+	struct jz4740_mmc_host *host = mmc_priv(mmc);
+
+	host->is_sdio_card = card->type == MMC_TYPE_SDIO ||
+			     card->type == MMC_TYPE_SD_COMBO;
+}
+
 static int jz4740_voltage_switch(struct mmc_host *mmc, struct mmc_ios *ios)
 {
 	int ret;
@@ -1056,6 +1183,7 @@ static const struct mmc_host_ops jz4740_mmc_ops = {
 	.get_ro		= mmc_gpio_get_ro,
 	.get_cd		= mmc_gpio_get_cd,
 	.enable_sdio_irq = jz4740_mmc_enable_sdio_irq,
+	.init_card = jz4740_mmc_init_card,
 	.start_signal_voltage_switch = jz4740_voltage_switch,
 };
 
@@ -1087,6 +1215,12 @@ static int jz4740_mmc_probe(struct platform_device* pdev)
 
 	/* Default if no match is JZ4740 */
 	host->version = (enum jz4740_mmc_version)device_get_match_data(&pdev->dev);
+	host->force_clkrt0_for_rw =
+		true;//device_property_read_bool(&pdev->dev, "ingenic,force-clkrt0-for-rw");
+	host->is_sdio_card =
+		true;//device_property_read_bool(&pdev->dev, "ingenic,sdio-slot");
+	host->force_pio =
+		false;//device_property_read_bool(&pdev->dev, "ingenic,force-pio");
 
 	ret = mmc_of_parse(mmc);
 	if (ret)
@@ -1150,6 +1284,8 @@ static int jz4740_mmc_probe(struct platform_device* pdev)
 	host->irq_mask = ~0;
 
 	jz4740_mmc_reset(host);
+	writel(JZ_MMC_DEFAULT_RESTO, host->base + JZ_REG_MMC_RESTO);
+	writel(JZ_MMC_DEFAULT_RDTO, host->base + JZ_REG_MMC_RDTO);
 
 	ret = request_threaded_irq(host->irq, jz_mmc_irq, jz_mmc_irq_worker, 0,
 			dev_name(&pdev->dev), host);
@@ -1161,7 +1297,7 @@ static int jz4740_mmc_probe(struct platform_device* pdev)
 	jz4740_mmc_clock_disable(host);
 	timer_setup(&host->timeout_timer, jz4740_mmc_timeout, 0);
 
-	if (host->version > JZ_MMC_JZ4730) {
+	if (!host->force_pio && host->version > JZ_MMC_JZ4730) {
 		ret = jz4740_mmc_acquire_dma_channels(host);
 		if (ret == -EPROBE_DEFER)
 			goto err_free_irq;
