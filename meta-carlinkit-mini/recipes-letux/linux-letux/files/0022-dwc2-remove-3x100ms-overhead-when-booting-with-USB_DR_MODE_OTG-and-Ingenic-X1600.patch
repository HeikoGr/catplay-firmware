Subject: [PATCH] dwc2: remove 3x100ms overhead when booting with USB_DR_MODE_OTG and Ingenic X1600 

---
 drivers/usb/dwc2/core.c   | 54 ++++++++++++++++++++++++++++++++-------
 drivers/usb/dwc2/params.c | 24 ++++++++++++++---
 2 files changed, 70 insertions(+), 8 deletions(-)
 
diff --git a/drivers/usb/dwc2/core.c b/drivers/usb/dwc2/core.c
index 9919ab725d54..375e543d5f73 100644
--- a/drivers/usb/dwc2/core.c
+++ b/drivers/usb/dwc2/core.c
@@ -294,9 +294,21 @@ static void dwc2_wait_for_mode(struct dwc2_hsotg *hsotg,
 	ktime_t start;
 	ktime_t end;
 	unsigned int timeout = 110;
+	u32 gotgctl;
+	u32 gusbcfg;
+	u32 gintsts;
+	u32 gintmsk;
+	u32 grstctl;
 
-	dev_vdbg(hsotg->dev, "Waiting for %s mode\n",
-		 host_mode ? "host" : "device");
+	gotgctl = dwc2_readl(hsotg, GOTGCTL);
+	gusbcfg = dwc2_readl(hsotg, GUSBCFG);
+	gintsts = dwc2_readl(hsotg, GINTSTS);
+	gintmsk = dwc2_readl(hsotg, GINTMSK);
+	grstctl = dwc2_readl(hsotg, GRSTCTL);
+	dev_info(hsotg->dev,
+		 "wait_for_mode(%s): start GOTGCTL=%08x GUSBCFG=%08x GINTSTS=%08x GINTMSK=%08x GRSTCTL=%08x\n",
+		 host_mode ? "host" : "device",
+		 gotgctl, gusbcfg, gintsts, gintmsk, grstctl);
 
 	start = ktime_get();
 
@@ -304,8 +316,15 @@ static void dwc2_wait_for_mode(struct dwc2_hsotg *hsotg,
 		s64 ms;
 
 		if (dwc2_is_host_mode(hsotg) == host_mode) {
-			dev_vdbg(hsotg->dev, "%s mode set\n",
-				 host_mode ? "Host" : "Device");
+			gotgctl = dwc2_readl(hsotg, GOTGCTL);
+			gusbcfg = dwc2_readl(hsotg, GUSBCFG);
+			gintsts = dwc2_readl(hsotg, GINTSTS);
+			grstctl = dwc2_readl(hsotg, GRSTCTL);
+			dev_info(hsotg->dev,
+				 "wait_for_mode(%s): done after %lld ms GOTGCTL=%08x GUSBCFG=%08x GINTSTS=%08x GRSTCTL=%08x\n",
+				 host_mode ? "host" : "device",
+				 ktime_to_ms(ktime_sub(ktime_get(), start)),
+				 gotgctl, gusbcfg, gintsts, grstctl);
 			break;
 		}
 
@@ -313,8 +332,15 @@ static void dwc2_wait_for_mode(struct dwc2_hsotg *hsotg,
 		ms = ktime_to_ms(ktime_sub(end, start));
 
 		if (ms >= (s64)timeout) {
-			dev_warn(hsotg->dev, "%s: Couldn't set %s mode\n",
-				 __func__, host_mode ? "host" : "device");
+			gotgctl = dwc2_readl(hsotg, GOTGCTL);
+			gusbcfg = dwc2_readl(hsotg, GUSBCFG);
+			gintsts = dwc2_readl(hsotg, GINTSTS);
+			gintmsk = dwc2_readl(hsotg, GINTMSK);
+			grstctl = dwc2_readl(hsotg, GRSTCTL);
+			dev_warn(hsotg->dev,
+				 "%s: Couldn't set %s mode after %lld ms GOTGCTL=%08x GUSBCFG=%08x GINTSTS=%08x GINTMSK=%08x GRSTCTL=%08x\n",
+				 __func__, host_mode ? "host" : "device", ms,
+				 gotgctl, gusbcfg, gintsts, gintmsk, grstctl);
 			break;
 		}
 
@@ -529,6 +555,12 @@ void dwc2_force_mode(struct dwc2_hsotg *hsotg, bool host)
 		return;
 
 	gusbcfg = dwc2_readl(hsotg, GUSBCFG);
+	dev_info(hsotg->dev,
+		 "force_mode(%s): before GOTGCTL=%08x GUSBCFG=%08x GINTSTS=%08x GINTMSK=%08x GRSTCTL=%08x\n",
+		 host ? "host" : "device",
+		 dwc2_readl(hsotg, GOTGCTL), gusbcfg,
+		 dwc2_readl(hsotg, GINTSTS), dwc2_readl(hsotg, GINTMSK),
+		 dwc2_readl(hsotg, GRSTCTL));
 
 	set = host ? GUSBCFG_FORCEHOSTMODE : GUSBCFG_FORCEDEVMODE;
 	clear = host ? GUSBCFG_FORCEDEVMODE : GUSBCFG_FORCEHOSTMODE;
@@ -536,6 +568,12 @@ void dwc2_force_mode(struct dwc2_hsotg *hsotg, bool host)
 	gusbcfg &= ~clear;
 	gusbcfg |= set;
 	dwc2_writel(hsotg, gusbcfg, GUSBCFG);
+	dev_info(hsotg->dev,
+		 "force_mode(%s): after  GOTGCTL=%08x GUSBCFG=%08x GINTSTS=%08x GINTMSK=%08x GRSTCTL=%08x\n",
+		 host ? "host" : "device",
+		 dwc2_readl(hsotg, GOTGCTL), dwc2_readl(hsotg, GUSBCFG),
+		 dwc2_readl(hsotg, GINTSTS), dwc2_readl(hsotg, GINTMSK),
+		 dwc2_readl(hsotg, GRSTCTL));
 
 	dwc2_wait_for_mode(hsotg, host);
 	return;
@@ -566,6 +604,10 @@ static void dwc2_clear_force_mode(struct dwc2_hsotg *hsotg)
 	gusbcfg &= ~GUSBCFG_FORCEDEVMODE;
 	dwc2_writel(hsotg, gusbcfg, GUSBCFG);
 
+	if (hsotg->dr_mode == USB_DR_MODE_OTG &&
+	    device_property_read_bool(hsotg->dev, "usb-role-switch") /* && dwc2_is_ingenic_x1600_family(hsotg) */ )
+		return;
+
 	if (dwc2_iddig_filter_enabled(hsotg))
 		msleep(100);
 }
diff --git a/drivers/usb/dwc2/params.c b/drivers/usb/dwc2/params.c
index 269f3b5c286d..8bbff9ee1e2d 100644
--- a/drivers/usb/dwc2/params.c
+++ b/drivers/usb/dwc2/params.c
@@ -924,6 +924,14 @@ static void dwc2_get_dev_hwparams(struct dwc2_hsotg *hsotg)
 				       FIFOSIZE_DEPTH_SHIFT;
 }
 
+static bool dwc2_is_ingenic_x1600_family(struct dwc2_hsotg *hsotg)
+{
+	return of_device_is_compatible(hsotg->dev->of_node, "ingenic,x1600-otg") ||
+	       of_device_is_compatible(hsotg->dev->of_node, "ingenic,x1700-otg") ||
+	       of_device_is_compatible(hsotg->dev->of_node, "ingenic,x1830-otg") ||
+	       of_device_is_compatible(hsotg->dev->of_node, "ingenic,x2000-otg");
+}
+
 /**
  * dwc2_get_hwparams() - During device initialization, read various hardware
  *                       configuration registers and interpret the contents.
@@ -1007,8 +1015,20 @@ int dwc2_get_hwparams(struct dwc2_hsotg *hsotg)
 	 * requires the controller to be in host mode. The mode will
 	 * be forced, if necessary, to read these values.
 	 */
-	dwc2_get_host_hwparams(hsotg);
-	dwc2_get_dev_hwparams(hsotg);
+	if (dwc2_is_ingenic_x1600_family(hsotg)) {
+		int fifo;
+		int fifo_count = dwc2_hsotg_tx_fifo_count(hsotg);
+
+		hw->host_nperio_tx_fifo_size = 3648;
+		hw->host_perio_tx_fifo_size = 1024;
+		hw->dev_nperio_tx_fifo_size = 3648;
+		memset(hw->g_tx_fifo_size, 0, sizeof(hw->g_tx_fifo_size));
+		for (fifo = 1; fifo <= fifo_count; fifo++)
+			hw->g_tx_fifo_size[fifo] = 3648;
+	} else {
+		dwc2_get_host_hwparams(hsotg);
+		dwc2_get_dev_hwparams(hsotg);
+	}
 
 	return 0;
 }
-- 
2.53.0
