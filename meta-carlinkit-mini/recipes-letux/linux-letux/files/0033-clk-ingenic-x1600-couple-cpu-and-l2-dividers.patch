Date: Sun, 9 Aug 2026 12:00:00 +0200
Subject: [PATCH] clk: ingenic: x1600: couple CPU and L2 dividers

The X1600 cannot run the L2 cache faster than the CPU.  The generic CPU
clock divider leaves the L2 divider unchanged, which hangs the system when
cpufreq lowers the CPU below the boot-time 552 MHz L2 rate.

Use a custom CPU clock which updates both fields of CPCCR in one change.
Match the vendor clock policy: L2 runs at half the CPU rate above 750 MHz
and at the CPU rate at or below 750 MHz.
---
 drivers/clk/ingenic/x1600-cgu.c | 76 +++++++++++++++++++++++++++++++++++++++---
 1 file changed, 74 insertions(+), 2 deletions(-)

diff --git a/drivers/clk/ingenic/x1600-cgu.c b/drivers/clk/ingenic/x1600-cgu.c
index 8b2f3aa00000..9d4c68300000 100644
--- a/drivers/clk/ingenic/x1600-cgu.c
+++ b/drivers/clk/ingenic/x1600-cgu.c
@@ -64,6 +64,78 @@
 
 static struct ingenic_cgu *cgu;
 
+#define CLOCKCONTROL_CPU_DIV_MASK	GENMASK(3, 0)
+#define CLOCKCONTROL_L2_DIV_MASK	GENMASK(7, 4)
+#define CLOCKCONTROL_CHANGE_ENABLE	BIT(22)
+#define CLOCKSTATUS_CPU_BUSY		BIT(0)
+
+static unsigned long x1600_cpu_recalc_rate(struct clk_hw *hw,
+					   unsigned long parent_rate)
+{
+	u32 val = readl(cgu->base + CGU_REG_CLOCKCONTROL);
+	unsigned int div = (val & CLOCKCONTROL_CPU_DIV_MASK) + 1;
+
+	return parent_rate / div;
+}
+
+static long x1600_cpu_round_rate(struct clk_hw *hw, unsigned long req_rate,
+				 unsigned long *parent_rate)
+{
+	unsigned int div;
+
+	div = DIV_ROUND_UP(*parent_rate, req_rate);
+	div = clamp(div, 1U, 16U);
+
+	return DIV_ROUND_UP(*parent_rate, div);
+}
+
+static int x1600_cpu_set_rate(struct clk_hw *hw, unsigned long req_rate,
+			      unsigned long parent_rate)
+{
+	unsigned long flags;
+	unsigned int cpu_div, l2_div;
+	u32 val, status;
+	int ret;
+
+	cpu_div = DIV_ROUND_UP(parent_rate, req_rate);
+	cpu_div = clamp(cpu_div, 1U, 16U);
+
+	/* Match the vendor relationship between the CPU and L2 clocks. */
+	if (req_rate <= 750000000)
+		l2_div = cpu_div;
+	else
+		l2_div = min(cpu_div * 2, 16U);
+
+	spin_lock_irqsave(&cgu->lock, flags);
+
+	val = readl(cgu->base + CGU_REG_CLOCKCONTROL);
+	val &= ~CLOCKCONTROL_CHANGE_ENABLE;
+	writel(val, cgu->base + CGU_REG_CLOCKCONTROL);
+
+	val &= ~(CLOCKCONTROL_CPU_DIV_MASK | CLOCKCONTROL_L2_DIV_MASK);
+	val |= cpu_div - 1;
+	val |= (l2_div - 1) << 4;
+	writel(val, cgu->base + CGU_REG_CLOCKCONTROL);
+
+	val |= CLOCKCONTROL_CHANGE_ENABLE;
+	writel(val, cgu->base + CGU_REG_CLOCKCONTROL);
+
+	ret = readl_poll_timeout_atomic(cgu->base + CGU_REG_CLOCKSTATUS,
+					status,
+					!(status & CLOCKSTATUS_CPU_BUSY),
+					0, 100 * USEC_PER_MSEC);
+
+	spin_unlock_irqrestore(&cgu->lock, flags);
+
+	return ret;
+}
+
+static const struct clk_ops x1600_cpu_ops = {
+	.recalc_rate = x1600_cpu_recalc_rate,
+	.round_rate = x1600_cpu_round_rate,
+	.set_rate = x1600_cpu_set_rate,
+};
+
 static int x1600_otg_phy_enable(struct clk_hw *hw)
 {
 	void __iomem *reg_opcr		= cgu->base + CGU_REG_OPCR;
@@ -213,14 +285,14 @@ static const struct ingenic_cgu_clk_info x1600_cgu_clocks[] = {
 	},
 
 	[X1600_CLK_CPU] = {
-		"cpu", CGU_CLK_DIV,
+		"cpu", CGU_CLK_CUSTOM,
 		/*
 		 * Disabling the CPU clock or any parent clocks will hang the
 		 * system; mark it critical.
 		 */
 		.flags = CLK_IS_CRITICAL,
 		.parents = { X1600_CLK_CPUMUX, -1, -1, -1 },
-		.div = { CGU_REG_CLOCKCONTROL, 0, 1, 4, 22, -1, -1 },
+		.custom = { &x1600_cpu_ops },
 	},
 
 	[X1600_CLK_L2CACHE] = {
-- 
2.51.0
