+	} else {
+		dev_warn(hsotg->dev,
+			 "%s: port power is NOT set - no device will ever be detected on this port\n",
+			 __func__);
 	}
 
 	/* Initialize and connect root hub if one is not already attached */
 	if (bus->root_hub) {
-		dev_dbg(hsotg->dev, "DWC OTG HCD Has Root Hub\n");
+		dev_info(hsotg->dev, "%s: resuming root hub\n", __func__);
