+	} else {
+		dev_warn(hsotg->dev, "%s: no root hub attached to this bus\n",
+			 __func__);
 	}
 
 	spin_unlock_irqrestore(&hsotg->lock, flags);
 
+	dwc2_hprt0_probe_start(hsotg);
+
 	return 0;
 }
 
