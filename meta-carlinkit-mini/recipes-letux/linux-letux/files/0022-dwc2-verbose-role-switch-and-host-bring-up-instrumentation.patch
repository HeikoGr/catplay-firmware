 /*
+ * Diagnostics: sample HPRT0 for a bounded window after the root hub has been
+ * activated. A head unit typically re-presents itself a few hundred ms after
+ * an accessory-initiated role switch and the iAP2 accessory probe window is
+ * 5s, so a single log line at bring-up cannot show whether anything ever
+ * attaches - the port has to be watched.
+ *
+ * This deliberately runs on system_wq, not on hsotg->wq_otg: the latter is an
+ * ordered workqueue (alloc_ordered_workqueue() in dwc2_hcd_init()), so a
+ * self-requeuing delayed work there would stall real OTG work for six
+ * seconds.
+ */
+#define DWC2_HPRT0_PROBE_INTERVAL_MS	250
+#define DWC2_HPRT0_PROBE_SAMPLES	24
+
+static void dwc2_hprt0_probe_func(struct work_struct *work)
+{
+	struct dwc2_hsotg *hsotg = container_of(work, struct dwc2_hsotg,
+						hprt0_probe_work.work);
+	u32 hprt0 = dwc2_readl(hsotg, HPRT0);
+
+	dev_info(hsotg->dev,
+		 "hprt0 sample %u/%u: HPRT0=%08x [%s%s%s%s%s%s] lnsts=%u spd=%u GINTSTS=%08x GINTMSK=%08x GOTGCTL=%08x\n",
+		 DWC2_HPRT0_PROBE_SAMPLES - hsotg->hprt0_probe_left + 1,
+		 DWC2_HPRT0_PROBE_SAMPLES, hprt0,
+		 hprt0 & HPRT0_PWR ? "PWR " : "",
+		 hprt0 & HPRT0_CONNSTS ? "CONNSTS " : "",
+		 hprt0 & HPRT0_CONNDET ? "CONNDET " : "",
+		 hprt0 & HPRT0_ENA ? "ENA " : "",
+		 hprt0 & HPRT0_SUSP ? "SUSP " : "",
+		 hprt0 & HPRT0_OVRCURRACT ? "OVRCURR " : "",
+		 (unsigned int)((hprt0 & HPRT0_LNSTS_MASK) >> HPRT0_LNSTS_SHIFT),
+		 (unsigned int)((hprt0 & HPRT0_SPD_MASK) >> HPRT0_SPD_SHIFT),
+		 dwc2_readl(hsotg, GINTSTS), dwc2_readl(hsotg, GINTMSK),
+		 dwc2_readl(hsotg, GOTGCTL));
+
+	if (--hsotg->hprt0_probe_left)
+		schedule_delayed_work(&hsotg->hprt0_probe_work,
+				      msecs_to_jiffies(DWC2_HPRT0_PROBE_INTERVAL_MS));
+}
+
+static void dwc2_hprt0_probe_start(struct dwc2_hsotg *hsotg)
+{
+	hsotg->hprt0_probe_left = DWC2_HPRT0_PROBE_SAMPLES;
+	mod_delayed_work(system_wq, &hsotg->hprt0_probe_work, 0);
+}
+
+/*
  * Reset work queue function
  */
 static void dwc2_hcd_reset_func(struct work_struct *work)
@@ -4252,7 +4310,8 @@
