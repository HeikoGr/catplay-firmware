Subject: [PATCH] x1600: add syscon support

This allows easy rebooting to Ingenic USB loader using `reboot usb` command or equiavelent syscall
(not guaranteed to be directly supported by Busybox)

diff --git a/arch/mips/boot/dts/ingenic/x1600.dtsi b/arch/mips/boot/dts/ingenic/x1600.dtsi
index eed0013f7..9280b3a37 100644
--- a/arch/mips/boot/dts/ingenic/x1600.dtsi
+++ b/arch/mips/boot/dts/ingenic/x1600.dtsi
@@ -12,6 +12,25 @@ / {
 	#size-cells = <1>;
 	compatible = "ingenic,x1600";
 
+	cpm: syscon@10000000 {
+		compatible = "ingenic,x1600-cpm", "syscon", "simple-mfd";
+		reg = <0x10000000 0x1000>;
+
+		/*
+		 * CPM_SLPC (0x100000cc)
+		 */
+		reboot_mode: reboot-mode {
+			compatible = "syscon-reboot-mode";
+
+			offset = <0xcc>;
+
+			mask = <0xffffffff>;
+
+			mode-normal = <0x00000000>;
+			mode-usb = <0x42575302>;
+		};
+	};
+
 	cpus: cpus {
 		#address-cells = <1>;
 		#size-cells = <0>;
