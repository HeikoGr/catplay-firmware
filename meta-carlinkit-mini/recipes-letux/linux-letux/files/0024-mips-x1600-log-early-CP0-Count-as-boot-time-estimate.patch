Subject: [PATCH] mips: x1600: log early CP0 Count as boot time estimate

Capture CP0 Count as early as setup_arch(), after CPU probing but before
prom_init().  At that point Linux has enough CPU state to read CP0, but has
not yet spent much time in the generic setup path.

The value is interpreted later in time_init(), after plat_time_init() has
initialized the clock tree.  Ingenic marks cpu_has_counter as false because
the platform uses an external timer, so fall back to the CPU clock from DT
and use the usual MIPS Count rate of CPU/2.

This gives a close estimate of the time spent before the kernel reached
early setup, primarily bootloader time plus the very first kernel instructions.

diff --git a/arch/mips/include/asm/time.h b/arch/mips/include/asm/time.h
index e855a3611..df4902f5e 100644
--- a/arch/mips/include/asm/time.h
+++ b/arch/mips/include/asm/time.h
@@ -27,6 +27,8 @@ extern void plat_time_init(void);
  * counter as a timer interrupt source.
  */
 extern unsigned int mips_hpt_frequency;
+extern unsigned int mips_early_cp0_count;
+extern int mips_early_cp0_count_valid;
 
 /*
  * The performance counter IRQ on MIPS is a close relative to the timer IRQ
diff --git a/arch/mips/kernel/setup.c b/arch/mips/kernel/setup.c
index 596578a7e..f6b160de4 100644
--- a/arch/mips/kernel/setup.c
+++ b/arch/mips/kernel/setup.c
@@ -43,8 +43,10 @@
 #include <asm/setup.h>
 #include <asm/smp-ops.h>
 #include <asm/mips-cps.h>
+#include <asm/mipsregs.h>
 #include <asm/prom.h>
 #include <asm/fw/fw.h>
+#include <asm/time.h>
 
 #ifdef CONFIG_MIPS_ELF_APPENDED_DTB
 char __section(".appended_dtb") __appended_dtb[0x100000];
@@ -776,6 +778,11 @@ void __init setup_arch(char **cmdline_p)
 	cpu_probe();
 	mips_cm_probe();
 
+	if (IS_ENABLED(CONFIG_MACH_X1600)) {
+		mips_early_cp0_count = read_c0_count();
+		mips_early_cp0_count_valid = 1;
+	}
+
 	if (IS_ENABLED(CONFIG_EARLY_PRINTK_8250) &&
 	    IS_ENABLED(CONFIG_MACH_INGENIC_SOC) &&
 	    IS_ENABLED(CONFIG_MACH_X1600))
diff --git a/arch/mips/kernel/time.c b/arch/mips/kernel/time.c
index ed339d797..658668670 100644
--- a/arch/mips/kernel/time.c
+++ b/arch/mips/kernel/time.c
@@ -7,10 +7,13 @@
  * Common time service routines for MIPS machines.
  */
 #include <linux/bug.h>
+#include <linux/clk.h>
 #include <linux/clockchips.h>
 #include <linux/types.h>
 #include <linux/kernel.h>
 #include <linux/init.h>
+#include <linux/of.h>
+#include <linux/of_clk.h>
 #include <linux/sched.h>
 #include <linux/param.h>
 #include <linux/time.h>
@@ -122,6 +125,8 @@ EXPORT_SYMBOL(perf_irq);
 
 unsigned int mips_hpt_frequency;
 EXPORT_SYMBOL_GPL(mips_hpt_frequency);
+unsigned int mips_early_cp0_count;
+int mips_early_cp0_count_valid;
 
 static __init int cpu_has_mfc0_count_bug(void)
 {
@@ -150,9 +155,63 @@ static __init int cpu_has_mfc0_count_bug(void)
 	return 0;
 }
 
+static unsigned long __init x1600_cp0_count_frequency(void)
+{
+	struct device_node *np;
+	struct clk *clk;
+	unsigned long rate = 0;
+	u32 clock_frequency;
+
+	if (mips_hpt_frequency)
+		return mips_hpt_frequency;
+
+	np = of_get_cpu_node(0, NULL);
+	if (!np)
+		return 0;
+
+	clk = of_clk_get(np, 0);
+	if (!IS_ERR(clk)) {
+		rate = clk_get_rate(clk);
+		clk_put(clk);
+	}
+
+	if (!rate &&
+	    !of_property_read_u32(np, "clock-frequency", &clock_frequency))
+		rate = clock_frequency;
+
+	of_node_put(np);
+
+	return rate / 2;
+}
+
+static void __init log_x1600_early_cp0_count(void)
+{
+	unsigned long count_hz;
+	u32 msec_remainder;
+	u64 msec;
+
+	if (!IS_ENABLED(CONFIG_MACH_X1600) || !mips_early_cp0_count_valid)
+		return;
+
+	count_hz = x1600_cp0_count_frequency();
+	if (!count_hz) {
+		pr_info("x1600: early MIPS CP0 Count: %u ticks, no count frequency available\n",
+			mips_early_cp0_count);
+		return;
+	}
+
+	msec = (u64)mips_early_cp0_count * MSEC_PER_SEC;
+	do_div(msec, count_hz);
+	msec_remainder = do_div(msec, MSEC_PER_SEC);
+
+	pr_info("x1600: early MIPS CP0 Count: %u ticks, approx %llu.%03u seconds at %lu Hz\n",
+		mips_early_cp0_count, msec, msec_remainder, count_hz);
+}
+
 void __init time_init(void)
 {
 	plat_time_init();
+	log_x1600_early_cp0_count();
 
 	/*
 	 * The use of the R4k timer as a clock event takes precedence;
