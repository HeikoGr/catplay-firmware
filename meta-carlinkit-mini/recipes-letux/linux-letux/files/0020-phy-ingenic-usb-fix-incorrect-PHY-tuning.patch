Subject: [PATCH] phy-ingenic-usb: fix incorrect PHY tuning

Letux enforces strict ASERFTUNE = 5V, meaning that if voltage on data pins drops below 5V(with what margin? nobody knows, it's not documented anywhere) the other side is considered disconnected.
When acting as a CarPlay dongle, automotive systems simply cannot keep up with such a requirement, resulting in a failed role-switch and a loop of reconnects that's not visible
in any logs, unless dwc2 debugs logs are enabled.

This reconstructs _exact_ PHY tuning dumped from a working CarPlay dongle, including setting ASERFTUNE = 4V.

It includes a couple other(reconstructed) changes to make the signal stronger, some of which seem to contribute to excessive heating.
However, it's hard to judge if there are actual car models that need this to work, or it was more of a precaution.

diff --git a/drivers/phy/ingenic/phy-ingenic-usb.c b/drivers/phy/ingenic/phy-ingenic-usb.c
index e69570e1d3e9..93270cdd56f8 100644
--- a/drivers/phy/ingenic/phy-ingenic-usb.c
+++ b/drivers/phy/ingenic/phy-ingenic-usb.c
@@ -25,9 +25,21 @@
 /* X1600 PHY register offsets */
 #define REG_PHY_PREEMPH1		0x30
 #define REG_PHY_PREEMPH2		0x40
+#define REG_PHY_RXCLK_PHASE		0x44
+#define REG_PHY_TXCLK_PHASE		0x48
+#define REG_PHY_DISCONN_DET_MSB		0x60
+#define REG_PHY_SQUELCH_DISCONN		0x64
+#define REG_PHY_DISCONN_DET_LSB		0x68
+#define REG_PHY_IO_HIGHZ		0x78
+#define REG_PHY_BANDGAP			0xa0
+#define REG_PHY_CHARGER_DETECT		0x100
+#define REG_PHY_CHARGER_CONTROL		0x104
 #define REG_PHY_VBUS			0x108
 #define REG_PHY_SESSIONVALID 		0x10c
 #define REG_PHY_SESSIONEND 		0x110
+#define REG_PHY_BALANCED_CLOCK		0x114
+#define REG_PHY_HS_ODT			0x11c
+#define REG_PHY_HS_SLEW			0x120
 #define REG_PHY_EYETUNE 		0x124
 
 /* bits within the USBPCR register */
@@ -94,22 +106,41 @@
 /* bits within the X1600 PHY registers */
 #define PHY_PREEMPH1_ENABLE_ALWAYS	GENMASK(2, 0)
 
-#define PHY_PREEMPH2_STRONGEST		GENMASK(5, 3)
+#define PHY_PREEMPH2_HBPREEM		BIT(6)
+#define PHY_PREEMPH2_TXHSPREEM		GENMASK(5, 3)
+#define PHY_PREEMPH2_TXHSPREEM_4	0x4
+
+#define PHY_DISCONN_DET_MSB_HSDISDETRI	GENMASK(1, 0)
+#define PHY_DISCONN_DET_MSB_HSDISDETRI_3	0x3
+
+#define PHY_SQUELCH_DISCONN_HSDISDETRI	BIT(7)
+#define PHY_SQUELCH_DISCONN_RXSQTRI	GENMASK(6, 3)
+#define PHY_SQUELCH_DISCONN_RXSQTRI_10	0xa
+
+#define PHY_DISCONN_DET_LSB_HSDISDETRI	BIT(0)
 
 #define PHY_VBUS_VBUSDETPOWERDOWN	BIT(3)
 
+#define PHY_CHARGER_DETECT_OEM		BIT(6)
+
 #define PHY_SESSIONVALID_BSEREFTUNE	GENMASK(5, 3)
-#define PHY_SESSIONVALID_BSEREFTUNE_5	BIT(5) | BIT(3)
+#define PHY_SESSIONVALID_BSEREFTUNE_5	0x5
 #define PHY_SESSIONVALID_ASEREFTUNE	GENMASK(2, 0)
-#define PHY_SESSIONVALID_ASEREFTUNE_5	BIT(2) | BIT(0)
+#define PHY_SESSIONVALID_ASEREFTUNE_4	0x4
 
 #define PHY_SESSIONEND_VBUSREFTUNE	GENMASK(5, 3)
-#define PHY_SESSIONEND_VBUSREFTUNE_5	BIT(5) | BIT(3)
+#define PHY_SESSIONEND_VBUSREFTUNE_1	0x1
 #define PHY_SESSIONEND_SEREFTUNE	GENMASK(2, 0)
-#define PHY_SESSIONEND_SEREFTUNE_5	BIT(2) | BIT(0)
+#define PHY_SESSIONEND_SEREFTUNE_5	0x5
+
+#define PHY_HS_ODT_HSRECVBIAS		BIT(7)
+#define PHY_HS_ODT_DISDETBIAS		GENMASK(6, 5)
+#define PHY_HS_ODT_DISDETBIAS_1		0x1
+#define PHY_HS_ODT_ODTTUNE		GENMASK(4, 0)
+#define PHY_HS_ODT_ODTTUNE_21		0x15
 
 #define PHY_EYETUNE_HSEYETUNE		GENMASK(4, 2)
-#define PHY_EYETUNE_HSEYETUNE_1		BIT(2)
+#define PHY_EYETUNE_HSEYETUNE_1		0x1
 
 struct ingenic_soc_info {
 	void (*usb_phy_init)(struct phy *phy);
@@ -306,17 +345,53 @@ static void x1600_usb_phy_init(struct phy *phy)
 	reg = readl(priv->extra + REG_PHY_PREEMPH1) | PHY_PREEMPH1_ENABLE_ALWAYS;
 	writel(reg, priv->extra + REG_PHY_PREEMPH1);
 
-	reg = readl(priv->extra + REG_PHY_PREEMPH2) | PHY_PREEMPH2_STRONGEST;
+	reg = readl(priv->extra + REG_PHY_PREEMPH2);
+	reg &= ~(PHY_PREEMPH2_HBPREEM | PHY_PREEMPH2_TXHSPREEM);
+	reg |= PHY_PREEMPH2_HBPREEM |
+		FIELD_PREP(PHY_PREEMPH2_TXHSPREEM,
+			   PHY_PREEMPH2_TXHSPREEM_4);
 	writel(reg, priv->extra + REG_PHY_PREEMPH2);
 
+	reg = readl(priv->extra + REG_PHY_DISCONN_DET_MSB);
+	reg &= ~PHY_DISCONN_DET_MSB_HSDISDETRI;
+	reg |= FIELD_PREP(PHY_DISCONN_DET_MSB_HSDISDETRI,
+			  PHY_DISCONN_DET_MSB_HSDISDETRI_3);
+	writel(reg, priv->extra + REG_PHY_DISCONN_DET_MSB);
+
+	reg = readl(priv->extra + REG_PHY_SQUELCH_DISCONN);
+	reg &= ~(PHY_SQUELCH_DISCONN_HSDISDETRI |
+		 PHY_SQUELCH_DISCONN_RXSQTRI);
+	reg |= PHY_SQUELCH_DISCONN_HSDISDETRI |
+		FIELD_PREP(PHY_SQUELCH_DISCONN_RXSQTRI,
+			   PHY_SQUELCH_DISCONN_RXSQTRI_10);
+	writel(reg, priv->extra + REG_PHY_SQUELCH_DISCONN);
+
+	reg = readl(priv->extra + REG_PHY_DISCONN_DET_LSB);
+	reg &= ~PHY_DISCONN_DET_LSB_HSDISDETRI;
+	writel(reg, priv->extra + REG_PHY_DISCONN_DET_LSB);
+
+	reg = readl(priv->extra + REG_PHY_HS_ODT);
+	reg &= ~(PHY_HS_ODT_HSRECVBIAS | PHY_HS_ODT_DISDETBIAS |
+		 PHY_HS_ODT_ODTTUNE);
+	reg |= PHY_HS_ODT_HSRECVBIAS |
+		FIELD_PREP(PHY_HS_ODT_DISDETBIAS, PHY_HS_ODT_DISDETBIAS_1) |
+		FIELD_PREP(PHY_HS_ODT_ODTTUNE, PHY_HS_ODT_ODTTUNE_21);
+	writel(reg, priv->extra + REG_PHY_HS_ODT);
+
 	reg = readl(priv->extra + REG_PHY_SESSIONVALID);
-	reg &= (PHY_SESSIONVALID_BSEREFTUNE | PHY_SESSIONVALID_ASEREFTUNE);
-	reg |= (PHY_SESSIONVALID_BSEREFTUNE_5 | PHY_SESSIONVALID_ASEREFTUNE_5);
+	reg &= ~(PHY_SESSIONVALID_BSEREFTUNE | PHY_SESSIONVALID_ASEREFTUNE);
+	reg |= FIELD_PREP(PHY_SESSIONVALID_BSEREFTUNE,
+			  PHY_SESSIONVALID_BSEREFTUNE_5) |
+		FIELD_PREP(PHY_SESSIONVALID_ASEREFTUNE,
+			   PHY_SESSIONVALID_ASEREFTUNE_4);
 	writel(reg, priv->extra + REG_PHY_SESSIONVALID);
 
 	reg = readl(priv->extra + REG_PHY_SESSIONEND);
-	reg &= (PHY_SESSIONEND_VBUSREFTUNE | PHY_SESSIONEND_SEREFTUNE);
-	reg |= (PHY_SESSIONEND_VBUSREFTUNE_5 | PHY_SESSIONEND_SEREFTUNE_5);
+	reg &= ~(PHY_SESSIONEND_VBUSREFTUNE | PHY_SESSIONEND_SEREFTUNE);
+	reg |= FIELD_PREP(PHY_SESSIONEND_VBUSREFTUNE,
+			  PHY_SESSIONEND_VBUSREFTUNE_1) |
+		FIELD_PREP(PHY_SESSIONEND_SEREFTUNE,
+			   PHY_SESSIONEND_SEREFTUNE_5);
 	writel(reg, priv->extra + REG_PHY_SESSIONEND);
 
 #ifdef CONFIG_USB_DWC2_EXT_VBUS_DETECT
@@ -325,7 +400,7 @@ static void x1600_usb_phy_init(struct phy *phy)
 #endif
 
 	reg = readl(priv->extra + REG_PHY_EYETUNE);
-	reg &= PHY_EYETUNE_HSEYETUNE;
-	reg |= PHY_EYETUNE_HSEYETUNE_1;
+	reg &= ~PHY_EYETUNE_HSEYETUNE;
+	reg |= FIELD_PREP(PHY_EYETUNE_HSEYETUNE, PHY_EYETUNE_HSEYETUNE_1);
 	writel(reg, priv->extra + REG_PHY_EYETUNE);
 }
