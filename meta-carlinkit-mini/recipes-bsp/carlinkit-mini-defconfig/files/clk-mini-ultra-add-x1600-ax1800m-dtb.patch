Subject: [PATCH] mips: ingenic: add X1600 AX1800M DTB target

Add a dedicated board selection for the Carlinkit Mini Ultra AX1800M
instead of reusing the Letux LX16 board and filtering its DTB out later.

---
 arch/mips/boot/dts/ingenic/Makefile | 1 +
 arch/mips/ingenic/Kconfig           | 4 ++++
 2 files changed, 5 insertions(+)

diff --git a/arch/mips/boot/dts/ingenic/Makefile b/arch/mips/boot/dts/ingenic/Makefile
index 0ad73bdea..267307a44 100644
--- a/arch/mips/boot/dts/ingenic/Makefile
+++ b/arch/mips/boot/dts/ingenic/Makefile
@@ -6,6 +6,7 @@ dtb-$(CONFIG_JZ4770_GCW0)	+= gcw0.dtb
 dtb-$(CONFIG_JZ4780_CI20)	+= ci20.dtb
 dtb-$(CONFIG_X1000_CU1000_NEO)	+= cu1000-neo.dtb
 dtb-$(CONFIG_X1600_LX16)	+= lx16.dtb
+dtb-$(CONFIG_X1600_AX1800M)	+= carlinkit-mini-ultra-nor.dtb
 dtb-$(CONFIG_X1830_CU1830_NEO)	+= cu1830-neo.dtb
 dtb-$(CONFIG_X2000_LX20)	+= lx20.dtb
 
diff --git a/arch/mips/ingenic/Kconfig b/arch/mips/ingenic/Kconfig
index 7c04faff4..b6eaf349a 100644
--- a/arch/mips/ingenic/Kconfig
+++ b/arch/mips/ingenic/Kconfig
@@ -77,6 +77,10 @@ config X1600_LX16
 	bool "Letux X1600 based SBC"
 	select MACH_X1600
 
+config X1600_AX1800M
+	bool "Carlinkit Mini Ultra AX1800M"
+	select MACH_X1600
+
 config X1830_CU1830_NEO
 	bool "YSH & ATIL CU1830 Module with Neo backplane"
 	select MACH_X1830
