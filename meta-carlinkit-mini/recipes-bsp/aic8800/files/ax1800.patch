diff --git a/aic8800_bsp/aic_bsp_driver.c b/aic8800_bsp/aic_bsp_driver.c
--- a/aic8800_bsp/aic_bsp_driver.c
+++ b/aic8800_bsp/aic_bsp_driver.c
@@ -16,6 +16,7 @@
 #include <linux/delay.h>
 #include <linux/vmalloc.h>
 #include <linux/firmware.h>
+#include <linux/gpio.h>
 
 #if LINUX_VERSION_CODE < KERNEL_VERSION(3, 12, 0)
 #include <linux/hardirq.h>
@@ -36,6 +37,8 @@
 extern char aic_fw_path[FW_PATH_MAX];
 extern struct aic_sdio_dev *aicbsp_sdiodev;
 
+#define AX1800M_BT_MODE_GPIO 89
+
 static void cmd_dump(const struct rwnx_cmd *cmd)
 {
 	printk(KERN_CRIT "tkn[%d]  flags:%04x  result:%3d  cmd:%4d - reqcfm(%4d)\n",
@@ -1654,7 +1657,7 @@ static struct aicbt_info_t aicbt_info[]={
         .txpwr_lvl     = AICBT_TXPWR_LVL_DEFAULT_8800dc,
     },//PRODUCT_ID_AIC8800DW
     {
-        .btmode        = AICBT_BTMODE_DEFAULT_8800d80,
+        .btmode        = AICBT_BTMODE_BT_ONLY, /* AX1800M: GPIO low */
         .btport        = AICBT_BTPORT_DEFAULT,
         .uart_baud     = AICBT_UART_BAUD_DEFAULT,
         .uart_flowctrl = AICBT_UART_FC_DEFAULT,
@@ -1692,8 +1695,40 @@ static struct aicbt_info_t aicbt_info[]={
 int aicbt_patch_table_load(struct aic_sdio_dev *sdiodev, struct aicbt_patch_table *head)
 {
 	struct aicbt_patch_table *p;
-	int ret = 0, i;
+	int ret = 0, i, gpio_ret, gpio_value;
+	struct gpio_desc *gpio_desc;
 	uint32_t *data = NULL;
+
+    /*
+     * GPIO 89 selects the AX1800M PCB antenna setup:
+     * low = BT_ONLY, high = BT_ONLY_COANT.
+     */
+    if (sdiodev->chipid == PRODUCT_ID_AIC8800D80) {
+        gpio_ret = gpio_request(AX1800M_BT_MODE_GPIO, "ax1800m-bt-mode");
+        if (gpio_ret) {
+            printk("%s failed to request AX1800M bt mode gpio[%d]:%d\n",
+                   __func__, AX1800M_BT_MODE_GPIO, gpio_ret);
+        } else {
+            gpio_desc = gpio_to_desc(AX1800M_BT_MODE_GPIO);
+            gpio_ret = gpio_desc ? gpiod_direction_input(gpio_desc) : -EINVAL;
+            if (gpio_ret) {
+                printk("%s failed to configure AX1800M bt mode gpio[%d]:%d\n",
+                       __func__, AX1800M_BT_MODE_GPIO, gpio_ret);
+            } else {
+                gpio_value = gpiod_get_raw_value(gpio_desc);
+                if (gpio_value < 0) {
+                    printk("%s failed to read AX1800M bt mode gpio[%d]:%d\n",
+                           __func__, AX1800M_BT_MODE_GPIO, gpio_value);
+                } else {
+                    printk("%s AX1800M bt mode gpio[%d]:%d\n", __func__,
+                           AX1800M_BT_MODE_GPIO, gpio_value);
+                    aicbt_info[sdiodev->chipid].btmode = gpio_value ?
+                        AICBT_BTMODE_BT_ONLY_COANT : AICBT_BTMODE_BT_ONLY;
+                }
+            }
+            gpio_free(AX1800M_BT_MODE_GPIO);
+        }
+    }
     if(head == NULL){
         return -1;
     }
