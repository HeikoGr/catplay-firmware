 #define SDIO_OTHER_INTERRUPT (0x1ul << 7)
+#define AICWF_IRQ_DRAIN_MAX_LOOPS 32
+
+static int aicwf_sdio_irq_state_fence(struct aic_sdio_dev *sdiodev, const char *tag)
+{
+	int ret = 0;
+	int i;
+	u8 intstatus = 0;
+
+	if (!sdiodev)
+		return -EINVAL;
+
+	if (sdiodev->chipid == PRODUCT_ID_AIC8800D80 ||
+	    sdiodev->chipid == PRODUCT_ID_AIC8800D80X2) {
+		for (i = 0; i < AICWF_IRQ_DRAIN_MAX_LOOPS; i++) {
+			u8 int_pending = 0;
+
+			ret = aicwf_sdio_readb(sdiodev, sdiodev->sdio_reg.misc_int_status_reg, &intstatus);
+			if (ret) {
+				sdio_err("%s: %s misc status read fail:%d\n", __func__, tag, ret);
+				return ret;
+			}
+			if (!(intstatus & SDIO_OTHER_INTERRUPT))
+				break;
+
+			ret = aicwf_sdio_readb(sdiodev, sdiodev->sdio_reg.sleep_reg, &int_pending);
+			if (ret) {
+				sdio_err("%s: %s pending read fail:%d\n", __func__, tag, ret);
+				return ret;
+			}
+			int_pending &= ~0x01; /* dev->host soft irq */
+			ret = aicwf_sdio_writeb(sdiodev, sdiodev->sdio_reg.sleep_reg, int_pending);
+			if (ret) {
+				sdio_err("%s: %s pending clear fail:%d\n", __func__, tag, ret);
+				return ret;
+			}
+		}
+		if (i == AICWF_IRQ_DRAIN_MAX_LOOPS)
+			sdio_err("%s: %s irq drain overflow, last=0x%02x\n", __func__, tag, intstatus);
+	} else {
+		for (i = 0; i < AICWF_IRQ_DRAIN_MAX_LOOPS; i++) {
+			ret = aicwf_sdio_readb(sdiodev, sdiodev->sdio_reg.block_cnt_reg, &intstatus);
+			if (ret) {
+				sdio_err("%s: %s block_cnt read fail:%d\n", __func__, tag, ret);
+				return ret;
+			}
+			if (!(intstatus & SDIO_OTHER_INTERRUPT))
+				break;
+		}
+		if (i == AICWF_IRQ_DRAIN_MAX_LOOPS)
+			sdio_err("%s: %s irq drain overflow, last=0x%02x\n", __func__, tag, intstatus);
+	}
+
+	return 0;
+}
 
