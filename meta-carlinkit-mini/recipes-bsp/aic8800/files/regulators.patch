+static bool cmd_mgr_list_sane(struct rwnx_cmd_mgr *cmd_mgr)
+{
+	struct list_head *head = &cmd_mgr->cmds;
+
+	if (!head->next || !head->prev)
+		return false;
+	if (head->next->prev != head)
+		return false;
+	if (head->prev->next != head)
+		return false;
+
+	return true;
