# U-Boot SPL (128 KB+128KB reserved, offset 0x400)
part clk-u-boot --source rawcopy --sourceparams="file=${CARLINKIT_WIC_UBOOT_PATH}" --offset ${CARLINKIT_UBOOT_OFFSET} --fixed-size ${CARLINKIT_UBOOT_SIZE} --no-table

# Persistent overlay, empty by default
part clk-csf --source rawcopy --sourceparams="file=${CARLINKIT_WIC_UBOOT_CSF_PATH}" --offset ${CARLINKIT_UBOOT_CSF_OFFSET} --fixed-size ${CARLINKIT_UBOOT_CSF_SIZE} --no-table

# U-Boot modern (~512 KB)
part u-boot --source rawcopy --sourceparams="file=${C2A_WIC_UBOOT_PATH}" --offset ${C2A_UBOOT_OFFSET} --fixed-size ${C2A_UBOOT_SIZE} --no-table

# Kernel (fitImage, ~14 MB)
part kernel --source rawcopy --sourceparams="file=${C2A_WIC_KERNEL_PATH}" --offset ${C2A_KERNEL_OFFSET} --fixed-size ${C2A_KERNEL_SIZE} --no-table

# Persistent overlay, empty by default
part / --source rawcopy --sourceparams="file=${C2A_WIC_ROOTFS_PATH}" --offset ${C2A_ROOTFS_OFFSET} --fixed-size ${C2A_ROOTFS_SIZE} --no-table
