/dts-v1/;

#include "imx6ull.dtsi"

/ {
	model = "Carlinkit C2A i.MX6ULL (Jailbreak)";
	compatible = "fsl,imx6ull", "fsl,c2a";

	chosen {
		stdout-path = &uart1;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x08000000>; // 128 MB
	};
	
	aliases {
		serial0 = &uart1;
		spi0 = &qspi;
		mmc0 = &usdhc1;
	};

	reg_usb_otg1_vbus: regulator-usb-otg1 {
        compatible = "regulator-fixed";
        regulator-name = "usb_otg2_vbus";
        regulator-min-microvolt = <5000000>;
        regulator-max-microvolt = <5000000>;
        enable-active-high;
		/* as seen in init_gpio.sh */
        gpio = <&gpio1 7 GPIO_ACTIVE_HIGH>;
        regulator-always-on;
    };

	reg_wifi: regulator-wifi {
		compatible = "regulator-fixed";
		regulator-name = "wlreg_on";
		gpio = <&gpio1 5 GPIO_ACTIVE_LOW>;
		enable-active-low;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
	};
};

&usdhc1 { /* Wi-Fi */
	pinctrl-names = "default", "state_100mhz", "state_200mhz";
	pinctrl-0 = <&pinctrl_usdhc1>;
	pinctrl-1 = <&pinctrl_usdhc1_100mhz>;
	pinctrl-2 = <&pinctrl_usdhc1_200mhz>;
	non-removable;
	no-1-8-v;
	keep-power-in-suspend;
	wakeup-source;
	vmmc-supply = <&reg_wifi>;

	status = "okay";
};

&qspi {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_qspi>;
	status = "okay";

	flash0: flash@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "macronix,mx25l12835f", "jedec,spi-nor";
		spi-max-frequency = <50000000>; /* possibly up to 60 */
		spi-rx-bus-width = <4>;         /* QSPI */
		spi-tx-bus-width = <1>;
		reg = <0>;
	};
};

&uart1 { /* serial */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

&uart2 { /* serial */
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart2>;
	status = "okay";
};

&usbotg1 { /* USB-A (for a pendrive) */
	dr_mode = "host";
	status = "okay";
	vbus-supply = <&reg_usb_otg1_vbus>;

	disable-over-current;
};

&usbotg2 { /* USB-C (for fastboot) */
	dr_mode = "peripheral";
	status = "okay";

	srp-disable;
	hnp-disable;
	adp-disable;
	disable-over-current;
};

&usbphy1 {
	fsl,tx-d-cal = <106>; /* signal strength */
};

&usbphy2 {
	fsl,tx-d-cal = <106>; /* signal strength */
};

&iomuxc {
	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX6UL_PAD_UART1_TX_DATA__UART1_DCE_TX 0x1b0b1
			MX6UL_PAD_UART1_RX_DATA__UART1_DCE_RX 0x1b0b1
		>;
	};

	pinctrl_uart2: uart2grp {
		fsl,pins = <
			MX6UL_PAD_UART2_TX_DATA__UART2_DCE_TX  0x1b0b1
			MX6UL_PAD_UART2_RX_DATA__UART2_DCE_RX  0x1b0b1
		>;
	};

	pinctrl_qspi: qspigrp {
		fsl,pins = <
			MX6UL_PAD_NAND_WP_B__QSPI_A_SCLK        0x70a1
			MX6UL_PAD_NAND_READY_B__QSPI_A_DATA00   0x70a1
			MX6UL_PAD_NAND_CE0_B__QSPI_A_DATA01     0x70a1
			MX6UL_PAD_NAND_CE1_B__QSPI_A_DATA02     0x70a1
			MX6UL_PAD_NAND_CLE__QSPI_A_DATA03       0x70a1
			MX6UL_PAD_NAND_DQS__QSPI_A_SS0_B        0x70a1
		>;
	};

	pinctrl_usdhc1: usdhc1grp {
		fsl,pins = <
			MX6UL_PAD_SD1_CMD__USDHC1_CMD        0x17059
			MX6UL_PAD_SD1_CLK__USDHC1_CLK        0x10071
			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0    0x17059
			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1    0x17059
			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2    0x17059
			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3    0x17059
			/*MX6UL_PAD_UART1_RTS_B__GPIO1_IO19    0x17059
			MX6UL_PAD_GPIO1_IO05__USDHC1_VSELECT 0x17059
			MX6UL_PAD_GPIO1_IO09__GPIO1_IO09     0x17059*/
		>;
	};

	pinctrl_usdhc1_100mhz: usdhc1-100mhz-grp {
		fsl,pins = <
			MX6UL_PAD_SD1_CMD__USDHC1_CMD     0x170b9
			MX6UL_PAD_SD1_CLK__USDHC1_CLK     0x100b9
			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0 0x170b9
			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1 0x170b9
			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2 0x170b9
			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3 0x170b9
		>;
	};

	pinctrl_usdhc1_200mhz: usdhc1-200mhz-grp {
		fsl,pins = <
			MX6UL_PAD_SD1_CMD__USDHC1_CMD     0x170f9
			MX6UL_PAD_SD1_CLK__USDHC1_CLK     0x100f9
			MX6UL_PAD_SD1_DATA0__USDHC1_DATA0 0x170f9
			MX6UL_PAD_SD1_DATA1__USDHC1_DATA1 0x170f9
			MX6UL_PAD_SD1_DATA2__USDHC1_DATA2 0x170f9
			MX6UL_PAD_SD1_DATA3__USDHC1_DATA3 0x170f9
		>;
	};
};