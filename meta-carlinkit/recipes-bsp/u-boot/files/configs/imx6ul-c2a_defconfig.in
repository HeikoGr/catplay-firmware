CONFIG_ARM=y
CONFIG_ARCH_MX6=y
CONFIG_SYS_MALLOC_LEN=0x1000000
CONFIG_NR_DRAM_BANKS=1
#CONFIG_SYS_MEMTEST_START=0x80000000
#CONFIG_SYS_MEMTEST_END=0x88000000
CONFIG_MX6UL=y
CONFIG_TARGET_MX6UL_C2A=y
# CONFIG_LDO_BYPASS_CHECK is not set
CONFIG_SYS_I2C_MXC_I2C1=n
CONFIG_SYS_I2C_MXC_I2C2=n
CONFIG_DM_GPIO=y
CONFIG_DEFAULT_DEVICE_TREE="imx6ul-c2a"
CONFIG_SUPPORT_RAW_INITRD=y
CONFIG_USE_BOOTCOMMAND=y
CONFIG_IMX_CONFIG="board/freescale/mx6ul_c2a/imximage.cfg"
CONFIG_BOOTDELAY=1
# CONFIG_CONSOLE_MUX is not set
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_BOARD_EARLY_INIT_F=y
CONFIG_SYS_MAXARGS=32
CONFIG_SYS_PBSIZE=532
CONFIG_CMD_BOOTZ=y
# CONFIG_CMD_IMLS is not set
CONFIG_CMD_MEMTEST=y
CONFIG_CMD_GPIO=y
CONFIG_CMD_I2C=y
CONFIG_CMD_MMC=y
CONFIG_CMD_SF=y
CONFIG_CMD_USB=y
CONFIG_CMD_USB_MASS_STORAGE=y
CONFIG_CMD_DHCP=n
CONFIG_CMD_PING=n
CONFIG_CMD_BMP=n
CONFIG_CMD_CACHE=y
CONFIG_CMD_NET=n
CONFIG_CMD_EXT2=n
CONFIG_CMD_EXT4=n
CONFIG_CMD_EXT4_WRITE=n
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_OF_CONTROL=y
CONFIG_ENV_OVERWRITE=y
CONFIG_QSPI_BOOT=y
# CONFIG_SPI_FLASH_USE_4K_SECTORS is not set
CONFIG_ENV_IS_NOWHERE=y
CONFIG_SYS_RELOC_GD_ENV_ADDR=y
CONFIG_SYS_MMC_ENV_DEV=1
CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG=y
CONFIG_USE_ETHPRIME=n
CONFIG_ETHPRIME="eth1"
CONFIG_BOUNCE_BUFFER=y
CONFIG_DM_74X164=n
CONFIG_DM_I2C=y
CONFIG_SYS_I2C_MXC=y
CONFIG_FSL_USDHC=y
CONFIG_DM_MMC=y
CONFIG_OF_PLATDATA=y
CONFIG_MTD=y
CONFIG_DM_SPI_FLASH=y
CONFIG_SPI_FLASH_MACRONIX=y
CONFIG_SF_DEFAULT_SPEED=40000000
CONFIG_PHYLIB=n
CONFIG_PHY_MICREL=n
CONFIG_PHY_MICREL_KSZ8XXX=n
CONFIG_DM_ETH_PHY=n
CONFIG_FEC_MXC=n
CONFIG_MII=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_IMX6=y
CONFIG_DM_REGULATOR=y
CONFIG_DM_REGULATOR_FIXED=y
CONFIG_DM_REGULATOR_GPIO=y
CONFIG_DM_SERIAL=y
CONFIG_MXC_UART=y
CONFIG_SPI=y
CONFIG_DM_SPI=y
CONFIG_FSL_QSPI=y
CONFIG_SOFT_SPI=y
CONFIG_IMX_THERMAL=y
CONFIG_USB=y
CONFIG_USB_MAX_CONTROLLER_COUNT=2
CONFIG_USB_STORAGE=y
CONFIG_USB_HOST_ETHER=y
CONFIG_USB_ETHER_ASIX=n
CONFIG_VIDEO=n
CONFIG_VIDEO_LINK=n
CONFIG_VIDEO_LOGO=n
CONFIG_SYS_WHITE_ON_BLACK=y
CONFIG_VIDEO_MXS=n
CONFIG_SPLASH_SCREEN=n
CONFIG_SPLASH_SCREEN_ALIGN=n
CONFIG_BMP_16BPP=n

CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_DOWNLOAD=y
CONFIG_USB_GADGET_DUALSPEED=y
CONFIG_USB_GADGET_MANUFACTURER="FSL"
CONFIG_USB_GADGET_VENDOR_NUM=0x1fc9
CONFIG_USB_GADGET_PRODUCT_NUM=0x0152
CONFIG_USB_GADGET_VBUS_DRAW=500
CONFIG_CI_UDC=y

CONFIG_CMD_FASTBOOT=y
CONFIG_USB_FUNCTION_FASTBOOT=y
CONFIG_FASTBOOT_UUU_SUPPORT=y
CONFIG_FASTBOOT=y
CONFIG_FASTBOOT_BUF_ADDR=0x83800000
CONFIG_FASTBOOT_BUF_SIZE=0x02000000
CONFIG_FASTBOOT_FLASH=y
CONFIG_EFI_PARTITION=n
CONFIG_CMD_CRC32=y
CONFIG_CRC32_VERIFY=y
CONFIG_PREBOOT="echo '>>> Preboot stage'"
CONFIG_USE_PREBOOT=y

CONFIG_QSPI_BOOT=y

CONFIG_EFI_LOADER=n

CONFIG_DM_USB_GADGET=y
CONFIG_DM_USB=y

CONFIG_DEBUG_UART=y
# UART1 0x02020000 UART2 0x021E8000
CONFIG_DEBUG_UART_BASE=0x02020000   
CONFIG_DEBUG_UART_CLOCK=24000000
CONFIG_BAUDRATE=115200
CONFIG_DEBUG_UART_MXC=y
CONFIG_DEBUG_UART_ANNOUNCE=y

## enable fit for imx6
CONFIG_FIT=y                      
CONFIG_FIT_VERBOSE=y            
CONFIG_FIT_SIGNATURE=n          
CONFIG_IMAGE_FORMAT_LEGACY=n
CONFIG_ZSTD=y
CONFIG_GZIP=y
CONFIG_ZLIB=y

## enable CSF append support
#CONFIG_IMX_HAB=y
#CONFIG_CSF_SIZE=0x2000

CONFIG_SYS_LOAD_ADDR=0x81000000
CONFIG_SYS_TEXT_BASE=0x80800000

# needed for USB-related bootscripts; can be disabled if there's binary size pressure
CONFIG_HUSH_PARSER=y

CONFIG_MMC_VERBOSE=y
CONFIG_MMC_IO_VOLTAGE=y
CONFIG_MMC_UHS_SUPPORT=y
CONFIG_MMC_HS200_SUPPORT=y
